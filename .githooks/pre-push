#!/usr/bin/env bash
# Same gate as .github/workflows/ci-test-reusable.yml — runs before git push.
set -euo pipefail

if [[ "${SKIP_CI_TEST:-}" == "1" ]]; then
  echo "pre-push: SKIP_CI_TEST=1 — skipping npm run ci:test"
  exit 0
fi

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

if [[ ! -f package.json ]]; then
  echo "pre-push: not a repo root with package.json — skip"
  exit 0
fi

echo "pre-push: running npm run ci:test (mirror of GitHub CI test job)…"
npm run ci:test
echo "pre-push: ci:test passed."