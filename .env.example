# Copy to .env in repo root (optional) or set in apps/api/.env
DATABASE_URL="postgresql://cms:cms@localhost:5432/cms?schema=public"
REDIS_URL="redis://localhost:6379"

# API (apps/api/.env)
JWT_SECRET="change-me-in-dev-use-long-random-string"
API_PORT=3000
# Set to false to disable Swagger UI + /docs-json (production)
# SWAGGER_ENABLED=false

# Web (apps/web/.env) — leave empty to use Vite proxy to API in dev
# VITE_API_URL="http://localhost:3000"

# Egypt ETA (production — prefer AWS Secrets Manager via scripts/configure-apprunner-eta.sh)
# ETA_API_BASE_URL=https://api.invoicing.eta.gov.eg
# ETA_CLIENT_ID=
# ETA_CLIENT_SECRET=
# ETA_SIGNING_KEY=
# ETA_DEFAULT_ISSUER_RIN=
# KIORLY_DEPLOY_TARGET=local  # App Runner sets aws — enables privileged MFA in production
# INSTAPAY_VERIFY_URL=
# FAWRY_VERIFY_URL=

# WhatsApp BSP (async outbound worker)
# WHATSAPP_API_URL=
# WHATSAPP_API_TOKEN=
