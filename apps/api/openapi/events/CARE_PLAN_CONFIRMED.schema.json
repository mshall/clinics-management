{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.kiorex.com/events/CARE_PLAN_CONFIRMED.schema.json",
  "title": "CARE_PLAN_CONFIRMED",
  "description": "DRAFT (phase P3, Nurse edition, nurse.care_plans / gate GKN1): the provider confirmed a care plan requested through POST /marketplace/v1/care-plan-requests. Carries the schedule with appointment IDs only; no clinical content, no address.",
  "x-producer": "kiorly-clinic",
  "x-status": "v2-draft",
  "allOf": [
    {
      "$ref": "envelope.schema.json"
    }
  ],
  "type": "object",
  "properties": {
    "type": {
      "const": "CARE_PLAN_CONFIRMED"
    },
    "aggregateType": {
      "const": "CarePlan"
    },
    "data": {
      "type": "object",
      "properties": {
        "carePlanId": {
          "type": "string",
          "minLength": 1
        },
        "clinicId": {
          "type": "string",
          "minLength": 1
        },
        "requestRef": {
          "type": [
            "string",
            "null"
          ],
          "description": "requestRef of the Kiorex care-plan request, when it originated there."
        },
        "edition": {
          "const": "NURSE"
        },
        "confirmedAt": {
          "type": "string",
          "format": "date-time"
        },
        "visits": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "appointmentId": {
                "type": "string",
                "minLength": 1
              },
              "startsAt": {
                "type": "string",
                "format": "date-time"
              },
              "endsAt": {
                "type": "string",
                "format": "date-time"
              },
              "serviceLocation": {
                "enum": [
                  "IN_CLINIC",
                  "HOME"
                ]
              }
            },
            "required": [
              "appointmentId",
              "startsAt"
            ]
          }
        },
        "visitAddress": false,
        "address": false,
        "line1": false,
        "lat": false,
        "lng": false,
        "latitude": false,
        "longitude": false,
        "geostamp": false,
        "phone": false,
        "aggregateType": {
          "type": "string",
          "description": "Injected by the Kiorly outbox; mirrors the envelope field."
        },
        "aggregateId": {
          "type": "string",
          "description": "Injected by the Kiorly outbox; mirrors the envelope field."
        }
      },
      "required": [
        "carePlanId",
        "clinicId",
        "confirmedAt",
        "visits"
      ]
    }
  },
  "required": [
    "type",
    "aggregateType",
    "data"
  ]
}
