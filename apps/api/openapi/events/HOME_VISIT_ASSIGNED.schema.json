{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.kiorex.com/events/HOME_VISIT_ASSIGNED.schema.json",
  "title": "HOME_VISIT_ASSIGNED",
  "description": "A clinician was assigned to a HOME visit (Clinic or Nurse edition; for agencies this is the dispatcher's assignment, shown to the patient before arrival, KNKX01). Carries the assignee's display name, photo URL and verification badge only. Never a phone number, address or coordinates (KX-09 §04). Ordered per appointment aggregate.",
  "x-producer": "kiorly-clinic",
  "x-status": "v2-draft",
  "allOf": [
    {
      "$ref": "envelope.schema.json"
    }
  ],
  "type": "object",
  "properties": {
    "type": {
      "const": "HOME_VISIT_ASSIGNED"
    },
    "aggregateType": {
      "const": "Appointment"
    },
    "data": {
      "type": "object",
      "properties": {
        "appointmentId": {
          "type": "string",
          "minLength": 1
        },
        "clinicId": {
          "type": "string",
          "minLength": 1
        },
        "externalReference": {
          "type": [
            "string",
            "null"
          ],
          "description": "Kiorex booking reference (kx_bk_...) for marketplace bookings."
        },
        "serviceLocation": {
          "const": "HOME"
        },
        "assignee": {
          "type": "object",
          "properties": {
            "clinicianId": {
              "type": "string",
              "minLength": 1
            },
            "displayName": {
              "type": "string",
              "minLength": 1
            },
            "photoUrl": {
              "type": [
                "string",
                "null"
              ],
              "format": "uri"
            },
            "badge": {
              "type": [
                "string",
                "null"
              ],
              "description": "Profession badge text, e.g. 'Verified nurse' (PRVER02)."
            },
            "profession": {
              "enum": [
                "PHYSICIAN",
                "DENTIST",
                "PHYSIOTHERAPIST",
                "NURSE"
              ],
              "description": "ADR-029. Market packs may extend the list in a later additive minor."
            },
            "phone": false,
            "mobile": false,
            "email": false
          },
          "required": [
            "clinicianId",
            "displayName"
          ]
        },
        "assignedAt": {
          "type": "string",
          "format": "date-time"
        },
        "visitAddress": false,
        "address": false,
        "line1": false,
        "lat": false,
        "lng": false,
        "latitude": false,
        "longitude": false,
        "geostamp": false,
        "phone": false,
        "aggregateType": {
          "type": "string",
          "description": "Injected by the Kiorly outbox; mirrors the envelope field."
        },
        "aggregateId": {
          "type": "string",
          "description": "Injected by the Kiorly outbox; mirrors the envelope field."
        }
      },
      "required": [
        "appointmentId",
        "clinicId",
        "serviceLocation",
        "assignee",
        "assignedAt"
      ]
    }
  },
  "required": [
    "type",
    "aggregateType",
    "data"
  ]
}
