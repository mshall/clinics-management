# One-shot idempotent Prisma seed (Lambda / CI). Build from repo root:
#   docker build -f apps/api/Dockerfile.seed .
# Build on the Lambda base image so Prisma ships rhel-openssl-3.0.x engine binaries.
FROM public.ecr.aws/lambda/nodejs:24 AS build
RUN dnf install -y openssl ca-certificates && dnf clean all
WORKDIR /repo
COPY package.json package-lock.json ./
COPY apps/api/package.json apps/api/
COPY apps/web/package.json apps/web/
COPY packages/field-visit/package.json packages/field-visit/
COPY vendor ./vendor
RUN npm ci && npm install -g prisma@7.10.1
COPY packages ./packages
COPY apps/api/prisma ./apps/api/prisma
COPY apps/api/prisma.config.ts ./apps/api/prisma.config.ts
COPY apps/api/tsconfig.json apps/api/tsconfig.seed.json ./apps/api/
COPY apps/api/scripts/copy-seed-assets.mjs ./apps/api/scripts/copy-seed-assets.mjs
COPY apps/api/src ./apps/api/src
WORKDIR /repo/apps/api
ENV DATABASE_URL="postgresql://build:build@127.0.0.1:5432/build?schema=public"
RUN npx prisma generate
# Q10: compiled demo seed (plain `node`, no tsx/ts-node at run time): dist-seed/prisma/demo/seed-demo.js (+ the base seed dist-seed/prisma/seed.js)
RUN npm run build -w @kiorly/field-visit --silent && npm run build:seed

FROM public.ecr.aws/lambda/nodejs:24
RUN dnf install -y openssl ca-certificates && dnf clean all
COPY --from=build /repo/node_modules ${LAMBDA_TASK_ROOT}/node_modules
COPY --from=build /repo/apps/api/prisma ${LAMBDA_TASK_ROOT}/prisma
COPY --from=build /repo/apps/api/prisma.config.ts ${LAMBDA_TASK_ROOT}/prisma.config.ts
# prisma/*.ts imports under ../src (tsx resolves .ts at runtime) — keep in sync with dockerfile-seed-src-coverage.node.test.ts
COPY apps/api/src/common/seed-demo-guard.ts ${LAMBDA_TASK_ROOT}/src/common/seed-demo-guard.ts
COPY apps/api/src/prisma/create-prisma-client.ts ${LAMBDA_TASK_ROOT}/src/prisma/create-prisma-client.ts
COPY apps/api/src/entitlements ${LAMBDA_TASK_ROOT}/src/entitlements
COPY apps/api/src/feature-flags/feature-flag-keys.ts ${LAMBDA_TASK_ROOT}/src/feature-flags/feature-flag-keys.ts
COPY apps/api/src/subscriptions ${LAMBDA_TASK_ROOT}/src/subscriptions
COPY apps/api/src/config/host-config.ts ${LAMBDA_TASK_ROOT}/src/config/host-config.ts
COPY apps/api/src/staging ${LAMBDA_TASK_ROOT}/src/staging
COPY apps/api/src/nurse/nurse-services.ts ${LAMBDA_TASK_ROOT}/src/nurse/nurse-services.ts
COPY apps/api/prisma/pilot-tenants.seed.ts ${LAMBDA_TASK_ROOT}/prisma/pilot-tenants.seed.ts
COPY infra/lambda/db-seed/run.mjs ${LAMBDA_TASK_ROOT}/index.mjs
# Q10: demo-data seed Lambda (handler demo-seed.handler, only deployed when enable_demo_seed = true; non-production)
COPY --from=build /repo/apps/api/dist-seed ${LAMBDA_TASK_ROOT}/dist-seed
# workspace packages: node_modules/@kiorly/field-visit is a symlink to ../../packages/field-visit
COPY --from=build /repo/packages ${LAMBDA_TASK_ROOT}/packages
COPY infra/lambda/demo-seed/run.mjs ${LAMBDA_TASK_ROOT}/demo-seed.mjs
ENV SEED_PRODUCT=kiorly-clinic SEED_BASE_ENTRY=dist-seed/prisma/seed.js SEED_DEMO_ENTRY=dist-seed/prisma/demo/seed-demo.js
ENV PATH="${LAMBDA_TASK_ROOT}/node_modules/.bin:/usr/local/bin:${PATH}"
CMD ["index.handler"]
