# Database — pick one:
#
# Docker Compose (repo root: docker compose up -d) uses user/db/password "cms":
# DATABASE_URL="postgresql://cms:cms@localhost:5432/cms?schema=public"
#
# Local Postgres superuser (default "postgres" DB exists out of the box):
# DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/postgres?schema=public"
#
# Or create a dedicated DB first: CREATE DATABASE cms; then:
# DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/cms?schema=public"

DATABASE_URL="postgresql://cms:cms@localhost:5432/cms?schema=public"
JWT_SECRET="dev-only-change-in-production-min-32-chars-please"
# Fixed OTP for local signup / E2E when WhatsApp is unavailable
SIGNUP_OTP_DEV_CODE=424242

# MS-01 Meta WhatsApp Cloud API (platform sender; templates in Market.providerConfig)
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_APP_SECRET=
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_API_VERSION=v21.0
# WHATSAPP_SANDBOX_NUMBERS=+201000000001,+201000000002
APP_WEB_URL=http://localhost:5173
AUTH_RESET_DEV_EXPOSE=1
PORT=3000
SWAGGER_ENABLED=true

# Uploads: local filesystem (default) or private S3 on App Runner / production.
# Encounter documents (labs, radiology, prescriptions) use the same storage backend.
# UPLOAD_STORAGE=local
# UPLOAD_LOCAL_ROOT=./uploads
#
# UPLOAD_STORAGE=s3
# S3_UPLOAD_BUCKET=your-private-bucket-name
# AWS_REGION=eu-central-1

# Optional: comma-separated emails that may use GET /admin/tenants and /admin/data-explorer/*.
# Organization GROUP_ADMIN users are not platform operators unless listed here.
# PLATFORM_SUPER_ADMIN_EMAILS=

# Optional: enable LLM answers (uses live org snapshot + role permissions). Without this, the assistant uses live DB lookups + rule-based replies.
# AI (dev only — resolved via Market.providerConfig.ai.secretRef env:OPENAI_API_KEY)
# OPENAI_API_KEY=
# AI_API_KEY=
# Production: store key in Secrets Manager; set market ai.secretRef to secret ARN (not plain env on App Runner).
