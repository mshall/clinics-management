# Database — pick one:
#
# Docker Compose (repo root: docker compose up -d) uses user/db/password "cms":
# DATABASE_URL="postgresql://cms:cms@localhost:5432/cms?schema=public"
#
# Local Postgres superuser (default "postgres" DB exists out of the box):
# DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/postgres?schema=public"
#
# Or create a dedicated DB first: CREATE DATABASE cms; then:
# DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/cms?schema=public"

DATABASE_URL="postgresql://cms:cms@localhost:5432/cms?schema=public"
# Pool size (Prisma 7 + pg adapter): `connection_limit=N` in the URL caps the pool; without it the pool uses DB_POOL_MAX, else 10 (explicit default).
# The shared local cluster has max_connections=100: seeds/tests use connection_limit=2..3; long-running APIs keep the default 10.
JWT_SECRET="dev-only-change-in-production-min-32-chars-please"
# Fixed OTP for local signup / E2E when WhatsApp is unavailable
SIGNUP_OTP_DEV_CODE=424242

# MS-01 Meta WhatsApp Cloud API (platform sender; templates in Market.providerConfig)
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_APP_SECRET=
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_API_VERSION=v21.0
# WHATSAPP_SANDBOX_NUMBERS=+201000000001,+201000000002
APP_WEB_URL=http://localhost:5174
AUTH_RESET_DEV_EXPOSE=1
PORT=3010
SWAGGER_ENABLED=true

# MS-05 transactional email (SES). Production requires DKIM+SPF+DMARC verified — see platform/email-domain-auth.json / Docs/MESSAGING_EMAIL.md
# EMAIL_SES_ENABLED=1  (legacy; use KIORLY_PROVIDER_MODE_EMAIL=real)

# Provider mode: every integration is MOCK by default (messages render into the dev inbox at /dev/inbox).
# KIORLY_PROVIDER_MODE=mock            # global default: mock | real
# KIORLY_PROVIDER_MODE_EMAIL=mock      # per integration: EMAIL | WHATSAPP | SMS | PUSH | PSP
# DEV_INBOX_ENABLED=1                  # production only: expose /api/v1/dev/inbox (needs DEV_INBOX_KEY + X-Dev-Inbox-Key)
# EMAIL_SES_REGION=eu-central-1
# EMAIL_FROM_ADDRESS=noreply@mail.kiorly.com
# EMAIL_SENDING_DOMAIN=mail.kiorly.com
# EMAIL_DKIM_VERIFIED=1
# EMAIL_SPF_VERIFIED=1
# EMAIL_DMARC_VERIFIED=1
# EMAIL_SES_WEBHOOK_SECRET=
# EMAIL_DEV_LOG=1

# Uploads: local filesystem (default) or private S3 on App Runner / production.
# Encounter documents (labs, radiology, prescriptions) use the same storage backend.
# UPLOAD_STORAGE=local
# UPLOAD_LOCAL_ROOT=./uploads
#
# UPLOAD_STORAGE=s3
# ON-03: 32-byte key (base64 or hex) for encrypting clinician national ID at rest
# CLINICIAN_PII_ENCRYPTION_KEY=

# S3_UPLOAD_BUCKET=your-private-bucket-name
# AWS_REGION=eu-central-1

# QA-05 on-call (optional): Slack incoming webhook + generic WhatsApp bridge
# PLATFORM_ONCALL_SLACK_WEBHOOK_URL=
# PLATFORM_ONCALL_WHATSAPP_WEBHOOK_URL=
# SENTRY_DSN=
# OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_SERVICE_NAME=kiorly-api
# DISABLE_OBSERVABILITY_SCHEDULER=true

# SC-02 Egypt paid launch: block until platform/pdpc-egypt-filings.json shows filings in hand
# PDPC_EGYPT_LAUNCH_GATE_BYPASS=1
# PDPC_EGYPT_FILINGS_PATH=

# Kiorex marketplace outbox (optional)
# Local Kiorex dev: KIOREX_OUTBOX_WEBHOOK_URL=http://localhost:4000/api/v1/webhooks/kiorly  KIOREX_OUTBOX_WEBHOOK_SECRET=kx_dev_webhook_secret
# KIOREX_OUTBOX_WEBHOOK_URL=
# KIOREX_OUTBOX_WEBHOOK_SECRET=
# KX-09 clinic booking links: public base for /b/<slug> pages and the Kiorex booking widget origin
# BOOKING_LINK_BASE_URL=https://kiorly.link
# KIOREX_BOOKING_WIDGET_URL=

# Optional: comma-separated emails that may use GET /admin/tenants and /admin/data-explorer/*.
# Organization GROUP_ADMIN users are not platform operators unless listed here.
# PLATFORM_SUPER_ADMIN_EMAILS=

# Optional: enable LLM answers (uses live org snapshot + role permissions). Without this, the assistant uses live DB lookups + rule-based replies.
# AI (dev only — resolved via Market.providerConfig.ai.secretRef env:OPENAI_API_KEY)
# OPENAI_API_KEY=
# AI_API_KEY=
# Production: store key in Secrets Manager; set market ai.secretRef to secret ARN (not plain env on App Runner).

# FF03 Kiorex feature-flag control plane (unset = no polling; pre-v2 local flag layers apply)
# KIOREX_CONTROL_PLANE_URL=http://localhost:4000
# KIOREX_FLAGS_PRODUCT_KEY=ff_kiorly-clinic_dev
# KIOREX_FLAGS_SECRET=ff_dev_secret_change_me
# KIOREX_FLAGS_WEBHOOK_SECRET=
# KIOREX_FLAGS_POLL_MS=30000
# KIOREX_FLAGS_STALE_ALERT_MS=600000

# KCV-201 Sign in with Kiorex Passport (unset = button hidden, no behaviour change)
# KIOREX_OIDC_ISSUER=http://localhost:4400
# KIOREX_OIDC_CLIENT_ID=kiorly-clinic
# KIOREX_OIDC_CLIENT_SECRET=dev-kiorly-clinic-secret
# KIOREX_OIDC_REDIRECT_URI=http://localhost:5174/auth/kiorex/callback

# Rev 2.3 home visits / Nurse edition
# HOME_VISIT_ADDRESS_ENCRYPTION_KEY=   # 32 bytes hex/base64, REQUIRED in production (AES-256-GCM home addresses)
# INTERNAL_JOB_KEY=                    # X-Internal-Job-Key for POST /api/v1/internal/jobs/* (closed with 503 when unset)
# KIORLY_PROVIDER_MODE_MAPS=mock       # route/maps adapter: mock (default) | real (Amazon Location, go-live)
# KIOREX_OIDC_REDIRECT_URI_NURSE=https://nurse.kiorly.com/auth/kiorex/callback   # same client (aud kiorly-clinic), nurse host redirect
# NURSE_WEB_URL=http://nurse.localhost:5174
# FAMILY_UPDATE_LINK_SECRET=           # HMAC secret for the family-update summary links (falls back to JWT_SECRET)
