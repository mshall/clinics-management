      "refundableMinor": 350,
      "expected": {
        "patientPaidRefundableMinor": 300,
        "creditRestoredMinor": 75,
        "cardRefundMinor": 225,
        "sponsoredVoidedMinor": 50
      }
    }
  ],
  "fifo": [
    {
      "name": "first expiring first",
      "lots": [
        {
          "id": "a",
          "remainingMinor": 3000,
          "expiresAt": "2027-06-01T00:00:00Z"
        },
        {
          "id": "b",
          "remainingMinor": 5000,
          "expiresAt": "2027-04-01T00:00:00Z"
        }
      ],
      "consumeMinor": 6000,
      "expected": [
        {
          "lotId": "b",
          "minor": 5000
        },
        {
          "lotId": "a",
          "minor": 1000
        }
      ]
    },
    {
      "name": "ties break by lot id",
      "lots": [
        {
          "id": "b",
          "remainingMinor": 1000,
          "expiresAt": "2027-04-01T00:00:00Z"
        },
        {
          "id": "a",
          "remainingMinor": 1000,
          "expiresAt": "2027-04-01T00:00:00Z"
        }
      ],
      "consumeMinor": 1500,
      "expected": [
        {
          "lotId": "a",
          "minor": 1000
        },
        {
          "lotId": "b",
          "minor": 500
        }
      ]
    },
    {
      "name": "scoped lots before unscoped",
      "lots": [
        {
          "id": "u",
          "remainingMinor": 2000,
          "expiresAt": "2027-03-01T00:00:00Z",
          "scoped": false
        },
        {
          "id": "s",
          "remainingMinor": 2000,
          "expiresAt": "2027-09-01T00:00:00Z",
          "scoped": true
        }
      ],
      "consumeMinor": 2500,
      "expected": [
        {
          "lotId": "s",
          "minor": 2000
        },
        {
          "lotId": "u",
          "minor": 500
        }
      ]
    },
    {
      "name": "more than available is refused",
      "lots": [
        {
          "id": "a",
          "remainingMinor": 1000,
          "expiresAt": "2027-06-01T00:00:00Z"
        }
      ],
      "consumeMinor": 1001,
      "expected": null
    },
    {
      "name": "exact",
      "lots": [
        {
          "id": "a",
          "remainingMinor": 1000,
          "expiresAt": "2027-06-01T00:00:00Z"
        }
      ],
      "consumeMinor": 1000,
      "expected": [
        {
          "lotId": "a",
          "minor": 1000
        }
      ]
    },
    {
      "name": "expired lot is skipped",
      "now": "2027-05-01T00:00:00Z",
      "lots": [
        {
          "id": "old",
          "remainingMinor": 9000,
          "expiresAt": "2027-04-01T00:00:00Z"
        },
        {
          "id": "new",
          "remainingMinor": 1000,
          "expiresAt": "2027-06-01T00:00:00Z"
        }
      ],
      "consumeMinor": 500,
      "expected": [
        {
          "lotId": "new",
          "minor": 500
        }
      ]
    }
  ],
  "expiry": [
