{
  "_source": "Fixed numeric vectors for the two credit ledgers (contracts 1.12.0, Rev 2.6, ADR-048 Proposed). Patient credit (kiorex-platform growth/rewards) and provider credit (clinics-management credits) are separate systems with separate ledgers; both must reproduce these numbers. Minor units, Math.round half up, largest remainder to the card line.",
  "rules": {
    "rounding": "Math.round(ratio * amount), residual to the card line",
    "refundRatio": "refundableMinor / priceMinor",
    "sponsoredShare": "voided, never refunded to the patient as cash or credit",
    "fifo": "scoped lots first, then first expiring, then lot id; expired lots are never consumed",
    "invariantRC4": "creditRestoredMinor + cardRefundMinor === patientPaidRefundableMinor"
  },
  "refundAllocation": [
    {
      "name": "doc example, full cancel before completion",
      "priceMinor": 50000,
      "sponsoredMinor": 10000,
      "creditMinor": 15000,
      "cardMinor": 25000,
      "heldDepositMinor": 0,
      "refundableMinor": 50000,
      "expected": {
        "patientPaidRefundableMinor": 40000,
        "creditRestoredMinor": 15000,
        "cardRefundMinor": 25000,
        "sponsoredVoidedMinor": 10000
      }
    },
    {
      "name": "doc example, 40 percent",
      "priceMinor": 50000,
      "sponsoredMinor": 10000,
      "creditMinor": 15000,
      "cardMinor": 25000,
      "heldDepositMinor": 0,
      "refundableMinor": 20000,
      "expected": {
        "patientPaidRefundableMinor": 16000,
        "creditRestoredMinor": 6000,
        "cardRefundMinor": 10000,
        "sponsoredVoidedMinor": 4000
      }
    },
    {
      "name": "card only, full",
      "priceMinor": 30000,
      "sponsoredMinor": 0,
      "creditMinor": 0,
      "cardMinor": 30000,
      "heldDepositMinor": 0,
      "refundableMinor": 30000,
      "expected": {
        "patientPaidRefundableMinor": 30000,
        "creditRestoredMinor": 0,
        "cardRefundMinor": 30000,
        "sponsoredVoidedMinor": 0
      }
    },
    {
      "name": "credit only, full",
      "priceMinor": 20000,
      "sponsoredMinor": 0,
      "creditMinor": 20000,
      "cardMinor": 0,
      "heldDepositMinor": 0,
      "refundableMinor": 20000,
      "expected": {
        "patientPaidRefundableMinor": 20000,
        "creditRestoredMinor": 20000,
        "cardRefundMinor": 0,
        "sponsoredVoidedMinor": 0
      }
    },
    {
      "name": "sponsored plus card, half",
      "priceMinor": 40000,
      "sponsoredMinor": 8000,
      "creditMinor": 0,
      "cardMinor": 32000,
      "heldDepositMinor": 0,
      "refundableMinor": 20000,
      "expected": {
        "patientPaidRefundableMinor": 16000,
        "creditRestoredMinor": 0,
        "cardRefundMinor": 16000,
        "sponsoredVoidedMinor": 4000
      }
    },
    {
      "name": "rounding: thirds",
      "priceMinor": 10000,
      "sponsoredMinor": 1000,
      "creditMinor": 3333,
      "cardMinor": 5667,
      "heldDepositMinor": 0,
      "refundableMinor": 3333,
      "expected": {
        "patientPaidRefundableMinor": 3000,
        "creditRestoredMinor": 1111,
        "cardRefundMinor": 1889,
        "sponsoredVoidedMinor": 333
      }
    },
    {
      "name": "rounding: one piastre",
      "priceMinor": 10001,
      "sponsoredMinor": 0,
      "creditMinor": 5001,
      "cardMinor": 5000,
      "heldDepositMinor": 0,
      "refundableMinor": 5001,
      "expected": {
        "patientPaidRefundableMinor": 5001,
        "creditRestoredMinor": 2501,
