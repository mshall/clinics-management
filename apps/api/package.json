{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "typecheck": "npm run build -w @kiorly/field-visit --silent && prisma generate && tsc --noEmit -p tsconfig.json",
    "build": "npm run build -w @kiorly/field-visit --silent && prisma generate && nest build",
    "predev": "npm run build -w @kiorly/field-visit --silent",
    "dev": "nest start --watch",
    "start": "node dist/src/main.js",
    "prisma:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:demo": "DEMO_SEED_ALLOWED=true tsx prisma/demo/seed-demo.ts",
    "db:seed:nurse": "tsx prisma/nurse-demo.seed.ts",
    "db:seed:demo:rev23": "DEMO_SEED_ALLOWED=true tsx prisma/demo/seed-rev23.ts",
    "demo:reset": "tsx scripts/reset-sales-demo-tenant.ts",
    "db:setup": "prisma generate && prisma migrate deploy && PRISMA_SEED_ENSURE_DEMO_PASSWORDS=true tsx prisma/seed.ts",
    "db:doctor": "tsx scripts/db-doctor.mjs",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "openapi:export": "tsx scripts/openapi-export.ts",
    "pretest:unit": "npm run build -w @kiorly/field-visit --silent",
    "pretest:integration": "npm run build -w @kiorly/field-visit --silent",
    "test:integration": "node --import tsx --test --test-concurrency=1 \"src/**/*.integration.test.ts\"",
    "test:unit": "node --import tsx --test \"src/**/*.node.test.ts\"",
    "test:money-coverage": "node scripts/money-path-coverage.mjs",
    "build:seed": "tsc -p tsconfig.seed.json && node scripts/copy-seed-assets.mjs",
    "db:seed:demo:dist": "node dist-seed/prisma/demo/seed-demo.js",
    "db:seed:dist": "node dist-seed/prisma/seed.js"
  },
  "dependencies": {
    "@kiorly/field-visit": "0.1.0",
    "@aws-sdk/client-s3": "^3.1045.0",
    "@aws-sdk/client-secrets-manager": "^3.1045.0",
    "@aws-sdk/client-ses": "^3.1172.0",
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/swagger": "^7.4.2",
    "@prisma/client": "^6.1.0",
    "@types/compression": "^1.8.1",
    "archiver": "^8.0.0",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "compression": "^1.8.2",
    "dotenv": "^16.4.7",
    "fflate": "^0.8.3",
    "jose": "^4.15.9",
    "libphonenumber-js": "^1.12.42",
    "luxon": "^3.7.2",
    "openid-client": "^5.7.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@types/archiver": "^8.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/luxon": "^3.7.6",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.2",
    "@types/passport-jwt": "^4.0.1",
    "@types/qrcode": "^1.5.6",
    "fast-check": "^3.23.2",
    "prisma": "^6.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
