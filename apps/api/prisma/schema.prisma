  ANNUAL
}

enum PriceUnit {
  PER_TENANT
  PER_CLINICIAN
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  GRACE
  READ_ONLY
  SUSPENDED
  CANCELLED
}

model Plan {
  id                     String            @id @default(cuid())
  key                    PlanKey           @unique
  nameEn                 String
  nameAr                 String
  isPublic               Boolean           @default(true)
  sortOrder              Int               @default(0)
  prices                 PlanPrice[]
  entitlements           PlanEntitlement[]
  subscriptions          Subscription[]
  trialSubscriptions     Subscription[]    @relation("SubscriptionTrialPlan")
  scheduledSubscriptions Subscription[]    @relation("SubscriptionScheduledPlan")
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
}

model PlanPrice {
  id                     String               @id @default(cuid())
  planId                 String
  plan                   Plan                 @relation(fields: [planId], references: [id], onDelete: Cascade)
  marketId               String
  market                 Market               @relation(fields: [marketId], references: [id], onDelete: Cascade)
  currency               String
  interval               BillingInterval
  unit                   PriceUnit
  amount                 Decimal              @db.Decimal(14, 2)
  includedClinicians     Int                  @default(1)
  extraClinicianAmount   Decimal?             @db.Decimal(14, 2)
  cohortKey              String?
  priceVersion           Int                  @default(1)
  validFrom              DateTime             @default(now())
  validTo                DateTime?
  subscriptions          Subscription[]
  scheduledSubscriptions Subscription[]       @relation("SubscriptionScheduledPlanPrice")
  priceMigrationsFrom    PlanPriceMigration[] @relation("PriceMigrationFrom")
  priceMigrationsTo      PlanPriceMigration[] @relation("PriceMigrationTo")
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt

  @@index([planId, marketId, interval])
  @@index([marketId, validFrom, validTo])
}

model PlanEntitlement {
  id        String   @id @default(cuid())
  planId    String
  plan      Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)
  key       String
  valueJson Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([planId, key])
}

model Subscription {
  id                       String               @id @default(cuid())
  tenantId                 String               @unique
  tenant                   Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  planId                   String
  plan                     Plan                 @relation(fields: [planId], references: [id], onDelete: Restrict)
  planPriceId              String?
  planPrice                PlanPrice?           @relation(fields: [planPriceId], references: [id], onDelete: Restrict)
  status                   SubscriptionStatus
  interval                 BillingInterval      @default(MONTHLY)
  clinicianSeats           Int                  @default(1)
  trialStartsAt            DateTime?
  trialEndsAt              DateTime?
  trialPlanId              String?
  trialPlan                Plan?                @relation("SubscriptionTrialPlan", fields: [trialPlanId], references: [id], onDelete: SetNull)
  activatedAt              DateTime?
  currentPeriodStart       DateTime
  currentPeriodEnd         DateTime
  prepaidUntil             DateTime?
  cohortKey                String?
  priceLockUntil           DateTime?
  cancelAtPeriodEnd        Boolean              @default(false)
  defaultPaymentMethodId   String?
  defaultPaymentMethod     KiorlyPaymentMethod? @relation(fields: [defaultPaymentMethodId], references: [id], onDelete: SetNull)
  kiorlyDunningPausedUntil DateTime?
  trialQualifiedAt         DateTime?
  trialShortenWarnedAt     DateTime?
  trialConfigOverride      Json?
  postTrialGraceUntil      DateTime?
  salesRepCode             String?
  referralCodeUsed         String?
  scheduledPlanId          String?
  scheduledPlan            Plan?                @relation("SubscriptionScheduledPlan", fields: [scheduledPlanId], references: [id], onDelete: SetNull)
  scheduledPlanPriceId     String?
  scheduledPlanPrice       PlanPrice?           @relation("SubscriptionScheduledPlanPrice", fields: [scheduledPlanPriceId], references: [id], onDelete: SetNull)
  scheduledInterval        BillingInterval?
  scheduledClinicianSeats  Int?
  scheduledEffectiveAt     DateTime?
  events                   SubscriptionEvent[]
  priceMigrations          PlanPriceMigration[]
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt

  @@index([planPriceId])
  @@index([scheduledPlanId])
  @@index([planId])
  @@index([status, currentPeriodEnd])
  @@index([status, trialEndsAt])
}

model SubscriptionEvent {
  id             String       @id @default(cuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  type           String
  fromJson       Json?
  toJson         Json?
  actorUserId    String?
  createdAt      DateTime     @default(now())

  @@index([subscriptionId, createdAt])
}

enum PriceMigrationStatus {
  SCHEDULED
  NOTICE_SENT
  APPLIED
  CANCELLED
}

/// SB-06 — existing subscription moves to a new PlanPrice version at a renewal after notice (never before priceLockUntil).
model PlanPriceMigration {
  id                    String               @id @default(cuid())
  tenantId              String
  tenant                Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscriptionId        String
  subscription          Subscription         @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  fromPlanPriceId       String
  fromPlanPrice         PlanPrice            @relation("PriceMigrationFrom", fields: [fromPlanPriceId], references: [id], onDelete: Cascade)
  toPlanPriceId         String
  toPlanPrice           PlanPrice            @relation("PriceMigrationTo", fields: [toPlanPriceId], references: [id], onDelete: Cascade)
  status                PriceMigrationStatus @default(SCHEDULED)
  noticeDueAt           DateTime
  effectiveAt           DateTime
  noticeSentAt          DateTime?
  priceLockUntil        DateTime?
  fromMonthlyAmount     Decimal              @db.Decimal(14, 2)
  toMonthlyAmount       Decimal              @db.Decimal(14, 2)
  currency              String
  consentByContinuingAt DateTime?
  appliedAt             DateTime?
  cancelledReason       String?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  @@unique([subscriptionId, toPlanPriceId])
  @@index([status, noticeDueAt])
  @@index([status, effectiveAt])
  @@index([tenantId])
}

/// PL-09 — founding cohort seat counter (per market).
model Cohort {
  key             String    @id
  marketId        String
  market          Market    @relation(fields: [marketId], references: [id], onDelete: Cascade)
  cap             Int
  assignedCount   Int       @default(0)
  opensAt         DateTime
  closesAt        DateTime?
  trialDays       Int?
  priceLockMonths Int       @default(24)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([marketId, opensAt])
}

enum UsageMetric {
  WHATSAPP_MESSAGES
  SMS_MESSAGES
  AI_SCRIBE_MINUTES
  AI_ASSISTANT_REQUESTS
  ACTIVE_CLINICIANS
}

/// PL-05 — monthly usage meters per tenant.
model UsageCounter {
  id        String      @id @default(cuid())
  tenantId  String
  periodKey String
  metric    UsageMetric
  quantity  Decimal     @default(0) @db.Decimal(14, 2)
  updatedAt DateTime    @updatedAt

  @@unique([tenantId, periodKey, metric])
  @@index([tenantId, periodKey])
}

model UsageMeterDedup {
  id        String      @id @default(cuid())
  tenantId  String
  metric    UsageMetric
  sourceId  String
  createdAt DateTime    @default(now())

  @@unique([tenantId, metric, sourceId])
}

/// CR-07 — owner nudges at 50/80/100% Kiorex free progress (once per period).
model KiorexProgressNudge {
  id        String   @id @default(cuid())
  tenantId  String
  periodKey String
  threshold Int
  createdAt DateTime @default(now())

  @@unique([tenantId, periodKey, threshold])
  @@index([tenantId, periodKey])
}

/// MS-04 — staff WhatsApp digest / CR-07 nudge preferences (quiet hours + opt-out).
model StaffDigestPreference {
  userId               String   @id
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenantId             String
  doctorTomorrowList   Boolean  @default(true)
  ownerWeeklyInsights  Boolean  @default(true)
  ownerShiftSummaries  Boolean  @default(true)
  kiorexProgressNudges Boolean  @default(true)
  optOutAll            Boolean  @default(false)
  /// Local hour 0–23 when quiet hours start (inclusive). Default 21.
  quietHoursStart      Int      @default(21)
  /// Local hour 0–23 when quiet hours end (exclusive). Default 8 (wraps midnight).
  quietHoursEnd        Int      @default(8)
  updatedAt            DateTime @updatedAt

  @@index([tenantId])
}

/// RP-02 — weekly Excel/PDF report delivery to owners (email + WhatsApp).
model TenantReportSchedule {
  tenantId        String   @id
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  enabled         Boolean  @default(true)
  /// xlsx | pdf
  format          String   @default("xlsx")
  /// JSON string array of report keys (e.g. ["payments","operations"]).
  reportKeys      Json     @default("[\"payments\",\"operations\"]")
  channelEmail    Boolean  @default(true)
  channelWhatsApp Boolean  @default(true)
  /// ISO day of week 1=Monday … 7=Sunday.
  dayOfWeek       Int      @default(1)
  hourLocal       Int      @default(9)
  updatedAt       DateTime @updatedAt
}

/// MS-04 — in-app owner/doctor notices (CR-07 progress, monthly recap, weekly insights).
model StaffInAppNotice {
  id        String    @id @default(cuid())
  tenantId  String
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String
  titleEn   String
  titleAr   String    @default("")
  bodyEn    String
  bodyAr    String    @default("")
  metadata  Json?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt, createdAt])
  @@index([tenantId, createdAt])
}

/// MS-04 — idempotent digest sends (one per user/kind/period).
model DigestSendLog {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String
  periodKey String
  createdAt DateTime @default(now())

  @@unique([userId, kind, periodKey])
  @@index([tenantId, kind, periodKey])
}

/// SC-05 — owner / data-subject export jobs with expiring download links.
model TenantExportJob {
  id                String    @id @default(cuid())
  tenantId          String
  tenant            Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// TENANT | PATIENT | ORG_SQL | ORG_DOCUMENTS | ORG_FULL | ORG_IMPORT
  scope             String
  patientId         String?
  status            String    @default("PENDING")
  /// 0–100 while RUNNING / READY
  progress          Int       @default(0)
  /// Selected explorer table keys for ORG_* exports
  tablesJson        Json?
  fileName          String?
  contentType       String?
  requestedBy       String
  downloadTokenHash String?   @unique
  expiresAt         DateTime?
  artifactPath      String?
  error             String?
  rowCounts         Json?
  createdAt         DateTime  @default(now())
  completedAt       DateTime?

  @@index([tenantId, createdAt])
  @@index([status, createdAt])
}

/// SC-05 — cancellation → retention → deletion; legal hold blocks deletion.
model TenantOffboarding {
  tenantId            String    @id
  tenant              Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cancelledAt         DateTime?
  retentionEndsAt     DateTime?
  deletionScheduledAt DateTime?
  deletedAt           DateTime?
  legalHold           Boolean   @default(false)
  noticeSentAt        DateTime?
  updatedAt           DateTime  @updatedAt
}

enum ReferralStatus {
  PENDING
  REWARDED
  REJECTED
}

/// CR-09 — shareable doctor-to-doctor referral code per organization.
model ReferralCode {
  code      String   @id
  tenantId  String   @unique
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

/// CR-09 — pending/rewarded referral attribution.
model Referral {
  id               String         @id @default(cuid())
  code             String
  referrerTenantId String
  referrerTenant   Tenant         @relation("ReferrerTenant", fields: [referrerTenantId], references: [id], onDelete: Cascade)
  referredTenantId String         @unique
  referredTenant   Tenant         @relation("ReferredTenant", fields: [referredTenantId], references: [id], onDelete: Cascade)
  status           ReferralStatus @default(PENDING)
  rewardedAt       DateTime?
  rejectReason     String?
  createdAt        DateTime       @default(now())

  @@index([referrerTenantId, status])
  @@index([code])
}

model TenantEntitlementOverride {
  id        String    @id @default(cuid())
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  key       String
  valueJson Json
  reason    String
  expiresAt DateTime?
  createdBy String
  createdAt DateTime  @default(now())

  @@unique([tenantId, key])
  @@index([tenantId])
}

model MarketFeatureFlag {
  id          String   @id @default(cuid())
  marketId    String
  market      Market   @relation(fields: [marketId], references: [id], onDelete: Cascade)
  key         String
  enabled     Boolean  @default(false)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([marketId, key])
}

model TenantFeatureFlag {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  key         String
  enabled     Boolean  @default(false)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, key])
}

model ProviderCredential {
  id           String        @id @default(cuid())
  tenantId     String
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clinicId     String?
  clinic       Clinic?       @relation(fields: [clinicId], references: [id], onDelete: SetNull)
  providerKey  String
  deviceId     String?
  secretRef    String
  label        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
