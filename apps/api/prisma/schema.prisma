model AppointmentWaitlistEntry {
  id                          String                    @id @default(cuid())
  tenantId                    String
  tenant                      Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clinicId                    String
  clinic                      Clinic                    @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patientId                   String
  patient                     Patient                   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  clinicianId                 String?
  clinician                   User?                     @relation("WaitlistClinician", fields: [clinicianId], references: [id], onDelete: SetNull)
  appointmentTypeId           String?
  appointmentType             AppointmentType?          @relation(fields: [appointmentTypeId], references: [id], onDelete: SetNull)
  preferredFrom               DateTime?
  preferredTo                 DateTime?
  status                      AppointmentWaitlistStatus @default(WAITING)
  offeredSlotAt               DateTime?
  notes                       String?
  /// CLINIC (front desk) | KIOREX (joined from the Kiorex patient app via marketplace/v1/waitlist).
  source                      String                    @default("CLINIC")
  /// Kiorex waitlist reference for source=KIOREX (idempotency key for join / leave / offers).
  externalRef                 String?                   @unique
  platformIntegrationClientId String?
  createdAt                   DateTime                  @default(now())
  updatedAt                   DateTime                  @updatedAt
  slotOffers                  WaitlistSlotOffer[]

  @@index([tenantId, clinicId, status])
  @@index([patientId])
}

enum WaitlistOpenSlotStatus {
  OPEN
  FILLED
  FILLED_ELSEWHERE
  EXHAUSTED
  CLOSED
}

enum WaitlistOfferStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
  WITHDRAWN
  SKIPPED
}

/// FS-03 a cancelled appointment's time, offered to the waitlist in order. openKey is set only while OPEN (one open row per clinician+time).
model WaitlistOpenSlot {
  id                  String                 @id @default(cuid())
  tenantId            String
  tenant              Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clinicId            String
  clinicianId         String
  startsAt            DateTime
  endsAt              DateTime?
  appointmentTypeId   String?
  feeAmount           Decimal                @default(0) @db.Decimal(14, 2)
  sourceAppointmentId String?
  status              WaitlistOpenSlotStatus @default(OPEN)
  openKey             String?                @unique
  filledAppointmentId String?
  closedAt            DateTime?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  offers              WaitlistSlotOffer[]

  @@index([tenantId, status])
}

/// FS-03 one WhatsApp offer of a slot to one waitlisted patient. activeSlotId = slotId while PENDING, so a slot can never be on offer to two people at once.
model WaitlistSlotOffer {
  id                  String                   @id @default(cuid())
  tenantId            String
  tenant              Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  slotId              String
  slot                WaitlistOpenSlot         @relation(fields: [slotId], references: [id], onDelete: Cascade)
  waitlistEntryId     String
  waitlistEntry       AppointmentWaitlistEntry @relation(fields: [waitlistEntryId], references: [id], onDelete: Cascade)
  patientId           String
  status              WaitlistOfferStatus      @default(PENDING)
  activeSlotId        String?                  @unique
  offeredAt           DateTime                 @default(now())
  expiresAt           DateTime
  respondedAt         DateTime?
  outboundMessageId   String?
  bookedAppointmentId String?
  skipReason          String?

  @@unique([slotId, waitlistEntryId])
  @@index([tenantId, status, expiresAt])
  @@index([waitlistEntryId])
}

