model Market {
  id                           String                        @id @default(cuid())
  code                         String                        @unique
  nameEn                       String
  nameAr                       String                        @default("")
  status                       MarketLaunchStatus            @default(DRAFT)
  launchedAt                   DateTime?
  dataRegion                   String                        @default("eu-central-1")
  hostCell                     String
  defaultCurrency              String
  defaultLocale                String
  defaultTimezone              String
  weekendDays                  Json
  enabledLanguages             Json
  defaultPhoneRegion           String
  idDocumentTypes              Json                          @default("[]")
  taxConfig                    Json                          @default("{}")
  providerConfig               Json                          @default("{}")
  clinicalConfig               Json                          @default("{}")
  legalConfig                  Json                          @default("{}")
  paymentMethods               Json                          @default("[]")
  featureDefaults              Json                          @default("{}")
  commercialConfig             Json                          @default("{}")
  settingsSchema               Json                          @default("{}")
  translations                 Json                          @default("{}")
  operationalStatus            MarketOperationalStatus       @default(ACTIVE)
  pausedUntil                  DateTime?
  lastProvisionNote            String?
  createdAt                    DateTime                      @default(now())
  updatedAt                    DateTime                      @updatedAt
  tenants                      Tenant[]
  featureFlags                 MarketFeatureFlag[]
  drugDatasetVersions          DrugDatasetVersion[]
  drugProducts                 DrugProduct[]
  planPrices                   PlanPrice[]
  cohorts                      Cohort[]
  kiorexCommissionRates        KiorexCommissionRate[]
  kiorlyInvoiceNumberSequences KiorlyInvoiceNumberSequence[]
}

model KiorexCommissionRate {
  id                 String             @id @default(cuid())
  marketId           String
  market             Market             @relation(fields: [marketId], references: [id], onDelete: Cascade)
  /// Rev 2.3 — optional narrowing: a rate may apply to one profession and/or one service location (most specific wins).
  profession         Profession?
  serviceLocation    ServiceLocation?
  specialty          ClinicalSpecialty?
  feeType            FeeType            @default(FLAT)
  amount             Decimal?           @db.Decimal(14, 2)
  percent            Decimal?           @db.Decimal(5, 2)
  minAmount          Decimal?           @db.Decimal(14, 2)
  maxAmount          Decimal?           @db.Decimal(14, 2)
  benchmarkFlat      Decimal?           @db.Decimal(14, 2)
  benchmarkPercent   Decimal?           @db.Decimal(5, 2)
  benchmarkSource    String?
  benchmarkCheckedAt DateTime?
  validFrom          DateTime           @default(now())
  validTo            DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  commissionCharges KiorexCommissionCharge[]

  @@index([marketId, specialty])
  @@index([marketId, validFrom, validTo])
}

enum CommissionChargeStatus {
  PENDING
  CONFIRMED
  DISPUTED
  REVERSED
  WAIVED
  BILLED
}

enum CommissionDisputeReason {
  EXISTING_PATIENT
  DID_NOT_ATTEND
  DUPLICATE
  OTHER
  /// Growth engine (GRW-P1-D0): the provider shows Kiorex attribution evidence that the booking was provider-led (auto-approvable when the signed evidence confirms it).
  PROVIDER_LED_EVIDENCE
}

enum CommissionDisputeStatus {
  OPEN
  AUTO_APPROVED
  APPROVED
  REJECTED
}

model KiorexCommissionCharge {
  id                String                 @id @default(cuid())
  tenantId          String
  tenant            Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clinicId          String
  clinic            Clinic                 @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  appointmentId     String                 @unique
  appointment       Appointment            @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  patientId         String
  patient           Patient                @relation(fields: [patientId], references: [id], onDelete: Cascade)
  clinicianId       String
  clinician         User                   @relation("KiorexCommissionClinician", fields: [clinicianId], references: [id], onDelete: Restrict)
  rateId            String
  rate              KiorexCommissionRate   @relation(fields: [rateId], references: [id], onDelete: Restrict)
  amount            Decimal                @db.Decimal(14, 2)
  currency          String
  status            CommissionChargeStatus @default(PENDING)
  attendedAt        DateTime
  confirmedAt       DateTime?
  disputeDeadline   DateTime
  kiorlyInvoiceId   String?
  kiorlyInvoice     KiorlyInvoice?         @relation(fields: [kiorlyInvoiceId], references: [id], onDelete: SetNull)
  reversalReason    String?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  commissionDispute CommissionDispute?

  @@index([tenantId, status, attendedAt])
  @@index([tenantId, attendedAt])
}

model CommissionDispute {
  id         String                  @id @default(cuid())
  chargeId   String                  @unique
  charge     KiorexCommissionCharge  @relation(fields: [chargeId], references: [id], onDelete: Cascade)
  tenantId   String
  tenant     Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  reason     CommissionDisputeReason
  note       String?
  status     CommissionDisputeStatus @default(OPEN)
  resolvedBy String?
  resolution String?
  createdAt  DateTime                @default(now())
  resolvedAt DateTime?

  @@index([status, createdAt])
  @@index([tenantId])
}

