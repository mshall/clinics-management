  @@index([tenantId, userId])
  @@index([tenantId])
}

model ClinicianVerification {
  id                  String                     @id @default(cuid())
  userId              String                     @unique
  user                User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenantId            String
  tenant              Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  syndicateNumber     String?
  specialty           ClinicalSpecialty?
  titleEn             String?
  titleAr             String?
  nationalIdEnc       String?
  documentKeys        Json                       @default("[]")
  status              VerificationStatus         @default(UNVERIFIED)
  rejectReason        String?
  rejectReasonCode    String?
  reviewedBy          String?
  reviewer            User?                      @relation("ClinicianVerificationReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)
  reviewedAt          DateTime?
  pendingAt           DateTime?
  reviewDurationMs    Int?
  lastReviewChecklist Json                       @default("[]")
  verifiedSpecialty   ClinicalSpecialty?
  /// PRVER01 — profession this record is being / was verified for (snapshot of User.profession at submit / approval).
  profession          Profession?
  verifiedProfession  Profession?
  /// PRVER03 — name at last approval; a change forces re-verification (hazard H11).
  verifiedName        String?
  /// PRVER04 — solo practitioner (no agency/clinic behind them): extra identity evidence required.
  isSolo              Boolean                    @default(false)
  /// PRVER03 — why the record was sent back to PENDING / EXPIRED (NAME_CHANGED, PROFESSION_CHANGED, SPECIALTY_CHANGED, LICENCE_EXPIRED).
  reverifyReason      String?
  verifiedAt          DateTime?
  /// PRVER03 — earliest of licence expiry and the pack's periodic re-verification date.
  nextReverifyAt      DateTime?
  /// PRVER03 — highest expiry-reminder stage sent (index into the pack's reminderDays).
  expiryReminderStage Int                        @default(0)
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt
  registrations       ProfessionalRegistration[]

  @@index([tenantId, status])
  @@index([status])
  @@index([pendingAt])
  @@index([status, nextReverifyAt])
}

/// PRVER01 — one row per professional register checked before LIVE (syndicate, MoH licence, ...), per market pack rule.
model ProfessionalRegistration {
  id                 String                 @id @default(cuid())
  tenantId           String
  tenant             Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId             String
  user               User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  verificationId     String?
  verification       ClinicianVerification? @relation(fields: [verificationId], references: [id], onDelete: SetNull)
  profession         Profession
  /// Register code from the market pack, e.g. EG_MEDICAL_SYNDICATE, EG_MOH_LICENCE.
  registerCode       String
  registrationNumber String
  issuedAt           DateTime?
  expiresAt          DateTime?
  status             VerificationStatus     @default(PENDING)
  verifiedAt         DateTime?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  @@unique([userId, registerCode])
  @@index([tenantId, status])
  @@index([status, expiresAt])
}

