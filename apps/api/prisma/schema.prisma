/// MN-01 — every movement of money into or out of the drawer that is not a visit-fee check-in.
model CashMovement {
  id            String        @id @default(cuid())
  tenantId      String
  clinicId      String
  patientId     String?
  /// IN | OUT
  direction     String
  method        PaymentMethod
  amount        Decimal       @db.Decimal(14, 2)
  currency      String
  /// PAYMENT | DEPOSIT | PACKAGE_SALE | REFUND | DEPOSIT_RELEASE | PACKAGE_CANCEL
  sourceType    String
  sourceId      String
  cashierUserId String?
  createdAt     DateTime      @default(now())

  @@index([tenantId, clinicId, createdAt])
  @@index([sourceType, sourceId])
}

/// MN-01 — refund of recognised revenue. Completed refunds own exactly one revenue reversal and one cash movement.
model BillingRefund {
  id                     String        @id @default(cuid())
  tenantId               String
  clinicId               String
  patientId              String
  paymentId              String?
  revenueEntryId         String?
  amount                 Decimal       @db.Decimal(14, 2)
  currency               String
  method                 PaymentMethod
  reason                 String
  /// PENDING_APPROVAL | COMPLETED | REJECTED
  status                 String        @default("COMPLETED")
  requestedByUserId      String
  approvedByUserId       String?
  decidedAt              DateTime?
  reversalRevenueEntryId String?       @unique
  cashMovementId         String?       @unique
  creditNoteId           String?       @unique
  createdAt              DateTime      @default(now())

  @@index([tenantId, clinicId, createdAt])
  @@index([tenantId, status])
  @@index([patientId])
  @@index([paymentId])
  @@index([revenueEntryId])
}

/// MN-01 — money taken before the service: a liability until applied (revenue) or released (cash back).
model PatientDeposit {
  id              String        @id @default(cuid())
  tenantId        String
  clinicId        String
  patientId       String
  appointmentId   String?
  amount          Decimal       @db.Decimal(14, 2)
  currency        String
  method          PaymentMethod
  /// CLINIC | KIOREX_PAY | PAYMENT_LINK
  source          String        @default("CLINIC")
  /// PENDING | HELD | APPLIED | RELEASED | FORFEITED
  status          String        @default("HELD")
  revenueEntryId  String?       @unique
  paymentId       String?       @unique
  createdByUserId String?
  appliedAt       DateTime?
  releasedAt      DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([tenantId, patientId])
  @@index([tenantId, clinicId, status])
  @@index([appointmentId])
}

model CashierShiftClose {
  id              String   @id @default(cuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clinicId        String
  clinic          Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  cashierUserId   String
  shiftDate       DateTime @db.Date
  expectedCash    Decimal  @db.Decimal(14, 2)
  countedCash     Decimal  @db.Decimal(14, 2)
  expectedCard    Decimal  @db.Decimal(14, 2)
  countedCard     Decimal  @db.Decimal(14, 2)
  notes           String?
  closedAt        DateTime @default(now())

  @@index([tenantId, clinicId, shiftDate])
}

model CommissionRule {
  id              String   @id @default(cuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clinicianId     String?
  serviceCatalogItemId String?
  ruleType        String   @default("PERCENT")
  percent         Decimal? @db.Decimal(5, 2)
  fixedAmount     Decimal? @db.Decimal(14, 2)
  roomRental      Boolean  @default(false)
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([tenantId, active])
}

model PayerPreAuthorization {
  id              String       @id @default(cuid())
  tenantId        String
  payerCompanyId  String
  payerCompany    PayerCompany @relation(fields: [payerCompanyId], references: [id], onDelete: Cascade)
  patientId       String
  referenceCode   String
  approvedAmount  Decimal?     @db.Decimal(14, 2)
  status          String       @default("PENDING")
  validUntil      DateTime?    @db.Date
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([tenantId, patientId])
  @@index([payerCompanyId])
}

model PatientDataProtectionConsent {
  id              String   @id @default(cuid())
  tenantId        String
  patientId       String
  patient         Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  signedAt        DateTime @default(now())
  signedOnTablet  Boolean  @default(true)
  signerName      String?
  locale          String   @default("ar")
  ipAddress       String?
  createdAt       DateTime @default(now())

  @@index([tenantId, patientId])
}

/// SC-03 — effective consent per purpose (AI, marketplace, data processing).
model PatientConsent {
  id               String   @id @default(cuid())
  tenantId         String
  patientId        String
  patient          Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  purpose          String
  granted          Boolean
  source           String
  capturedAt       DateTime @default(now())
  signerName       String?
  signedOnTablet   Boolean?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([patientId, purpose])
  @@index([tenantId, patientId])
}

/// GT-02 — versioned legal document acceptance per user/tenant
model LegalAcceptance {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  document   String
  version    String
  acceptedAt DateTime @default(now())
  ip         String?

  @@index([tenantId, userId, document])
  @@index([userId, document, version])
}

model MessagingConsent {
  id        String         @id @default(cuid())
  tenantId  String
  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patientId String
  patient   Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  channel   MessageChannel
  purpose   String
  granted   Boolean
  source    String
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([patientId, channel, purpose])
  @@index([tenantId, patientId])
}

model MessageTemplate {
  id          String         @id @default(cuid())
  tenantId    String
  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  key         String
  channel     MessageChannel
  subjectEn   String?
  subjectAr   String?
  bodyEn      String
  bodyAr      String
  active      Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([tenantId, key, channel])
}

model OutboxEvent {
  id            String    @id @default(cuid())
  tenantId      String
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  aggregateType String
  aggregateId   String
  type          String
  payload       Json
  target        String    @default("KIOREX")
  status        String    @default("PENDING")
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now())
  createdAt     DateTime  @default(now())
  sentAt        DateTime?

  @@index([tenantId, status, createdAt])
  @@index([status, nextAttemptAt])
  @@index([aggregateType, aggregateId, createdAt])
}

model AppointmentRescheduleToken {
  id            String       @id @default(cuid())
  tenantId      String
  tenant        Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointmentId String       @unique
  appointment   Appointment  @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  tokenHash     String       @unique
  expiresAt     DateTime
  usedAt        DateTime?
  createdAt     DateTime     @default(now())

  @@index([tenantId])
}

/// CL-03: short-lived pharmacy verification link printed as a QR on signed prescriptions.
model PrescriptionVerificationToken {
  id              String    @id @default(cuid())
  tenantId        String
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  encounterId     String
  encounter       Encounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  tokenHash       String    @unique
  expiresAt       DateTime
  createdByUserId String?
  revokedAt       DateTime?
  lastViewedAt    DateTime?
  viewCount       Int       @default(0)
  createdAt       DateTime  @default(now())

  @@index([tenantId])
  @@index([encounterId])
}

/// CL-05 append-only amendment trail. One row per Amend; resignedAt is set when the amended note is signed again.
model EncounterAmendment {
  id               String    @id @default(cuid())
  tenantId         String
  tenant           Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  encounterId      String
  encounter        Encounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  reason           String
  amendedByUserId  String?
  amendedByName    String
  amendedAt        DateTime  @default(now())
  wasLocked        Boolean   @default(false)
  resignedByUserId String?
  resignedByName   String?
  resignedAt       DateTime?

  @@index([tenantId])
  @@index([encounterId, amendedAt])
}

model WhatsAppInboundEvent {
  id                String   @id @default(cuid())
  tenantId          String
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  providerMessageId String   @unique
  appointmentId     String?
  action            String
  payloadJson       Json?
  createdAt         DateTime @default(now())

  @@index([tenantId, appointmentId])
}

model OutboundMessage {
  id                String         @id @default(cuid())
  tenantId          String
  patientId         String?
  appointmentId     String?
  channel           MessageChannel
  templateKey       String?
  templateName      String?
  variablesJson     Json?
  toPhone           String
  body              String
  status            String         @default("QUEUED")
  providerMessageId String?        @unique
  failureClass      String?
  attemptCount      Int            @default(0)
  nextRetryAt       DateTime?
  metadata          Json?
  sentAt            DateTime?
  deliveredAt       DateTime?
  readAt            DateTime?
  error             String?
  createdAt         DateTime       @default(now())

  @@index([tenantId, status])
  @@index([tenantId, failureClass])
  @@index([appointmentId])
  @@index([patientId])
}

model RecallCampaign {
  id          String             @id @default(cuid())
  tenantId    String
  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  kind        RecallCampaignKind
  nameEn      String
  nameAr      String             @default("")
  acquisitionChannel PatientAcquisitionChannel?
  active      Boolean            @default(true)
  createdAt   DateTime           @default(now())

  @@index([tenantId, kind])
}

/// Retired by KX-08: Kiorex is the single source of reviews (see KiorexRating / KiorexReview). Kept read-only; no writers.
model SatisfactionSurveyResponse {
  id            String   @id @default(cuid())
  tenantId      String
  patientId     String
  patient       Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  appointmentId String?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  encounterId   String?
  clinicianId   String?
  score         Int
  comment       String?
  createdAt     DateTime @default(now())

  @@index([tenantId, clinicianId])
}

model ClinicalIncident {
  id          String   @id @default(cuid())
  tenantId    String
  clinicId    String
  reportedByUserId String?
  severity    String   @default("LOW")
  summaryEn   String
  summaryAr   String   @default("")
  status      String   @default("OPEN")
  createdAt   DateTime @default(now())

  @@index([tenantId, clinicId])
}

model AiScribeSession {
  id            String   @id @default(cuid())
  tenantId      String
  encounterId   String
  status        String   @default("DRAFT")
  transcript    String?
  draftNote     Json?
  draftRx       Json?
  approvedAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([tenantId, encounterId])
}

model OtpChallenge {
  id         String    @id @default(cuid())
  phone      String
  purpose    String
  codeHash   String
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([phone, purpose])
}

model CreditWallet {
  id        String              @id @default(cuid())
  tenantId  String              @unique
  currency  String
  balance   Decimal             @default(0) @db.Decimal(14, 2)
  version   Int                 @default(0)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  tenant    Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  entries   CreditLedgerEntry[]
}

model CreditLedgerEntry {
  id        String           @id @default(cuid())
  walletId  String
  wallet    CreditWallet     @relation(fields: [walletId], references: [id], onDelete: Cascade)
  type      CreditEntryType
  reason    CreditReason
  amount    Decimal          @db.Decimal(14, 2)
  remaining Decimal?         @db.Decimal(14, 2)
  expiresAt DateTime?
  sourceRef String?
  invoiceId String?
  note      String?
  createdBy String?
  createdAt DateTime         @default(now())

  @@index([walletId, createdAt])
  @@index([walletId, expiresAt])
}

model KiorlyInvoiceNumberSequence {
  id         String   @id @default(cuid())
  marketId   String
  market     Market   @relation(fields: [marketId], references: [id], onDelete: Cascade)
  year       Int
  lastNumber Int      @default(0)
  updatedAt  DateTime @updatedAt

  @@unique([marketId, year])
}

model KiorlyInvoice {
  id              String              @id @default(cuid())
  tenantId        String
  tenant          Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  number          String              @unique
  periodKey       String
  periodStart     DateTime
  periodEnd       DateTime
  status          KiorlyInvoiceStatus @default(DRAFT)
  currency        String
  subtotal        Decimal             @db.Decimal(14, 2)
  creditsApplied  Decimal             @default(0) @db.Decimal(14, 2)
  tax             Decimal             @db.Decimal(14, 2)
  total           Decimal             @db.Decimal(14, 2)
  amountPaid      Decimal             @default(0) @db.Decimal(14, 2)
  issuedAt        DateTime?
  dueAt           DateTime?
  paidAt          DateTime?
  etaUuid         String?
  creditMemo      Boolean             @default(false)
  voidOfInvoiceId String?
  voidOfInvoice   KiorlyInvoice?      @relation("KiorlyInvoiceVoid", fields: [voidOfInvoiceId], references: [id], onDelete: SetNull)
  voidCredits        KiorlyInvoice[]     @relation("KiorlyInvoiceVoid")
  lines              KiorlyInvoiceLine[]
  payments           KiorlyPayment[]
  kiorexCommissionCharges KiorexCommissionCharge[]
  paymentUnderReview Boolean             @default(false)
  autoChargeAttempts Int                 @default(0)
  nextAutoChargeAt   DateTime?
  settlementSummaryJson Json?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@unique([tenantId, periodKey])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@index([nextAutoChargeAt])
}

model KiorlyPaymentMethod {
  id        String                  @id @default(cuid())
  tenantId  String
  tenant    Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  provider  String
  kind      KiorlyPaymentMethodKind
  tokenRef  String?
  brand     String?
  last4     String?
  expMonth  Int?
  expYear   Int?
  isDefault Boolean                 @default(false)
  createdAt DateTime                @default(now())
  defaultForSubscriptions Subscription[]

  @@index([tenantId, isDefault])
  @@index([tenantId, provider])
}

model KiorlyPayment {
  id             String              @id @default(cuid())
  tenantId       String
  tenant         Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoiceId      String?
  invoice        KiorlyInvoice?      @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  provider       String
  providerRef    String              @unique
  amount         Decimal             @db.Decimal(14, 2)
  currency       String
  status         KiorlyPaymentStatus
  proofUploadKey String?
  verifiedBy     String?
  idempotencyKey String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([tenantId, createdAt])
  @@index([invoiceId, status])
  @@unique([provider, idempotencyKey])
}

model KiorlyPaymentWebhookEvent {
  id             String   @id @default(cuid())
  provider       String
  idempotencyKey String
  paymentId      String?
  payloadHash    String
  createdAt      DateTime @default(now())

  @@unique([provider, idempotencyKey])
}

model KiorlyInvoiceLine {
  id         String          @id @default(cuid())
  invoiceId  String
  invoice    KiorlyInvoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  type       KiorlyLineType
  descEn     String
  descAr     String
  quantity   Decimal         @db.Decimal(14, 2)
  unitAmount Decimal         @db.Decimal(14, 2)
  amount     Decimal         @db.Decimal(14, 2)
  refId      String?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@index([invoiceId])
}

model PasswordResetToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, createdAt])
}

model UserSession {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String
  expiresAt        DateTime
  revokedAt        DateTime?
  userAgent        String?
  ipHash           String?
  createdAt        DateTime  @default(now())
  lastSeenAt       DateTime  @default(now())

  @@index([userId, revokedAt])
  @@index([userId, expiresAt])
}
