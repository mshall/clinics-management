  id             String         @id @default(cuid())
  paymentId      String
  payment        BillingPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  method         PaymentMethod
  amount         Decimal        @db.Decimal(14, 2)
  /// Revenue row posted (via postRevenue) for this allocation.
  revenueEntryId String?        @unique

  @@index([paymentId])
}

model CreditNote {
  id               String   @id @default(cuid())
  tenantId         String
  clinicId         String
  patientId        String
  invoiceId        String?
  amount           Decimal  @db.Decimal(14, 2)
  currency         String   @default("EGP")
  reason           String
  approvedByUserId String?
  createdAt        DateTime @default(now())

  @@index([tenantId, clinicId])
  @@index([patientId])
}

model PatientServicePackage {
  id                String                      @id @default(cuid())
  tenantId          String
  tenant            Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patientId         String
  patient           Patient                     @relation(fields: [patientId], references: [id], onDelete: Cascade)
  nameEn            String
  nameAr            String                      @default("")
  totalSessions     Int
  sessionsRemaining Int
  paidAmount        Decimal                     @default(0) @db.Decimal(14, 2)
  currency          String                      @default("EGP")
  expiresOn         DateTime?                   @db.Date
  /// MN-01 — clinic that sold the package (cash movement + per-session revenue land here).
  clinicId          String?
  /// MN-01 — ACTIVE | EXHAUSTED | CANCELLED. Expiry is derived from `expiresOn`.
  status            String                      @default("ACTIVE")
  paymentMethod     PaymentMethod?
  soldByUserId      String?
  consumptions      PatientPackageConsumption[]
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt

  @@index([tenantId, patientId])
}

/// MN-01 — one session used from a prepaid package; revenue for the session is recognised here via postRevenue.
model PatientPackageConsumption {
  id               String                @id @default(cuid())
  tenantId         String
  packageId        String
  package          PatientServicePackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  appointmentId    String?
  amount           Decimal               @db.Decimal(14, 2)
  revenueEntryId   String?               @unique
  consumedByUserId String?
  createdAt        DateTime              @default(now())

  @@index([tenantId, packageId])
  @@index([appointmentId])
}

/// MN-01 — every movement of money into or out of the drawer that is not a visit-fee check-in.
model CashMovement {
  id            String        @id @default(cuid())
  tenantId      String
  clinicId      String
  patientId     String?
  /// IN | OUT
  direction     String
  method        PaymentMethod
  amount        Decimal       @db.Decimal(14, 2)
  currency      String
  /// PAYMENT | DEPOSIT | PACKAGE_SALE | REFUND | DEPOSIT_RELEASE | PACKAGE_CANCEL
  sourceType    String
  sourceId      String
  cashierUserId String?
  createdAt     DateTime      @default(now())

  @@index([tenantId, clinicId, createdAt])
  @@index([sourceType, sourceId])
}

/// MN-01 — refund of recognised revenue. Completed refunds own exactly one revenue reversal and one cash movement.
model BillingRefund {
  id                     String        @id @default(cuid())
  tenantId               String
  clinicId               String
  patientId              String
  paymentId              String?
  revenueEntryId         String?
  amount                 Decimal       @db.Decimal(14, 2)
  currency               String
  method                 PaymentMethod
  reason                 String
  /// PENDING_APPROVAL | COMPLETED | REJECTED
  status                 String        @default("COMPLETED")
  requestedByUserId      String
  approvedByUserId       String?
  decidedAt              DateTime?
  reversalRevenueEntryId String?       @unique
  cashMovementId         String?       @unique
  creditNoteId           String?       @unique
  createdAt              DateTime      @default(now())

  @@index([tenantId, clinicId, createdAt])
  @@index([tenantId, status])
  @@index([patientId])
  @@index([paymentId])
  @@index([revenueEntryId])
}

/// MN-01 — money taken before the service: a liability until applied (revenue) or released (cash back).
model PatientDeposit {
  id                 String        @id @default(cuid())
  tenantId           String
  clinicId           String
  patientId          String
  appointmentId      String?
  amount             Decimal       @db.Decimal(14, 2)
  currency           String
  method             PaymentMethod
  /// CLINIC | KIOREX_PAY | PAYMENT_LINK
  source             String        @default("CLINIC")
  /// PENDING | HELD | APPLIED | RELEASED | FORFEITED | EXPIRED | CANCELLED (EXPIRED/CANCELLED: unpaid link voided)
  status             String        @default("HELD")
  revenueEntryId     String?       @unique
  paymentId          String?       @unique
  /// KX-07 — payment reference from the collector (Kiorex Pay payment id, gateway ref).
  externalRef        String?
  /// KX-07 — Kiorex payout that settled this deposit to the clinic.
  payoutRef          String?
  /// FS-04 — sha256 of the payment-link token (raw token only ever goes to the patient).
  linkTokenHash      String?       @unique
  linkExpiresAt      DateTime?
  linkSentAt         DateTime?
  /// FS-04 — why the deposit was asked for: PATIENT_FLAG | NO_SHOWS | RISK_SCORE | APPOINTMENT_TYPE | MANUAL
  requirementReasons Json?
  paidAt             DateTime?
  createdByUserId    String?
  appliedAt          DateTime?
  releasedAt         DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@unique([tenantId, source, externalRef])
  @@index([tenantId, patientId])
  @@index([tenantId, clinicId, status])
  @@index([appointmentId])
}

/// KX-07 — money Kiorex paid out to the clinic for deposits it collected.
model KiorexPayout {
  id          String   @id @default(cuid())
  tenantId    String
  clinicId    String?
  payoutRef   String
  amount      Decimal  @db.Decimal(14, 2)
  currency    String
  paidAt      DateTime
  depositRefs Json     @default("[]")
  createdAt   DateTime @default(now())

  @@unique([tenantId, payoutRef])
  @@index([tenantId, paidAt])
}

model CashierShiftClose {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clinicId      String
  clinic        Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  cashierUserId String
  shiftDate     DateTime @db.Date
  expectedCash  Decimal  @db.Decimal(14, 2)
  countedCash   Decimal  @db.Decimal(14, 2)
  expectedCard  Decimal  @db.Decimal(14, 2)
  countedCard   Decimal  @db.Decimal(14, 2)
  notes         String?
  closedAt      DateTime @default(now())

  @@index([tenantId, clinicId, shiftDate])
}

/// MN-03 — cash drawer shift per clinic: opened with a float, closed with a blind count.
model CashierShift {
  id              String    @id @default(cuid())
  tenantId        String
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clinicId        String
  clinic          Clinic    @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  /// Z-report number, sequential per clinic.
  zNumber         Int
  /// OPEN | CLOSED
  status          String    @default("OPEN")
  currency        String
  openingFloat    Decimal   @db.Decimal(14, 2)
  openedBy        String
  openedAt        DateTime  @default(now())
  closedBy        String?
  closedAt        DateTime?
  expectedCash    Decimal?  @db.Decimal(14, 2)
  expectedCard    Decimal?  @db.Decimal(14, 2)
  countedCash     Decimal?  @db.Decimal(14, 2)
  countedCard     Decimal?  @db.Decimal(14, 2)
  cashVariance    Decimal?  @db.Decimal(14, 2)
  cardVariance    Decimal?  @db.Decimal(14, 2)
  varianceNote    String?
  /// Market pack threshold in force at close.
  reviewThreshold Decimal?  @db.Decimal(14, 2)
  needsReview     Boolean   @default(false)
  reviewedBy      String?
  reviewedAt      DateTime?
  reviewNote      String?
  /// Totals by method and by drawer movement type, frozen at close (Z-report).
  summaryJson     Json?

  @@unique([clinicId, zNumber])
  @@index([tenantId, clinicId, status])
  @@index([tenantId, needsReview])
}

/// MN-02 — doctor revenue-share rule. The most specific active match wins (clinician > service > payer > clinic, then priority).
model CommissionRule {
  id                   String   @id @default(cuid())
  tenantId             String
  tenant               Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clinicianId          String?
  clinicId             String?
  serviceCatalogItemId String?
  /// MN-02 — service match on the visit's appointment type.
  appointmentTypeId    String?
  /// MN-02 — service match on the revenue category (VISIT_FEE, OPERATION_PAYMENT, PACKAGE_SESSION…).
  revenueCategory      String?
  /// MN-02 — payer match: PATIENT, KIOREX_PAY (deposit collected by Kiorex)…
  payerKey             String?
  /// PERCENT | FIXED_PER_VISIT | ROOM_RENTAL
  ruleType             String   @default("PERCENT")
  percent              Decimal? @db.Decimal(5, 2)
  fixedAmount          Decimal? @db.Decimal(14, 2)
  roomRental           Boolean  @default(false)
  priority             Int      @default(0)
  label                String?
  active               Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([tenantId, active])
}

/// MN-02 — a doctor's revenue-share statement for one period (YYYY-MM). DRAFT is recomputed; APPROVED/PAID are locked.
model DoctorStatement {
  id              String    @id @default(cuid())
  tenantId        String
  clinicianId     String
  periodKey       String
  currency        String
  totalsJson      Json
  adjustmentsJson Json      @default("[]")
  payoutsJson     Json      @default("[]")
  /// DRAFT | APPROVED | PAID
  status          String    @default("DRAFT")
  approvedBy      String?
  approvedAt      DateTime?
  paidAt          DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([tenantId, clinicianId, periodKey])
  @@index([tenantId, periodKey])
}

model PayerPreAuthorization {
  id             String       @id @default(cuid())
  tenantId       String
  payerCompanyId String
  payerCompany   PayerCompany @relation(fields: [payerCompanyId], references: [id], onDelete: Cascade)
  patientId      String
  referenceCode  String
  approvedAmount Decimal?     @db.Decimal(14, 2)
  status         String       @default("PENDING")
  validUntil     DateTime?    @db.Date
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([tenantId, patientId])
  @@index([payerCompanyId])
}

model PatientDataProtectionConsent {
  id             String   @id @default(cuid())
  tenantId       String
  patientId      String
  patient        Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  signedAt       DateTime @default(now())
  signedOnTablet Boolean  @default(true)
  signerName     String?
  locale         String   @default("ar")
  ipAddress      String?
  createdAt      DateTime @default(now())

  @@index([tenantId, patientId])
}

/// KX-11 — consent scopes for sharing clinical records with the Kiorex patient app.
enum RecordShareScope {
  VISIT_SUMMARY
  PRESCRIPTIONS
  LAB_RESULTS
  SHARE_WITH_OTHER_CLINICS
}

model PatientRecordShareConsent {
  id         String           @id @default(cuid())
  tenantId   String
  patientId  String
  patient    Patient          @relation(fields: [patientId], references: [id], onDelete: Cascade)
  scope      RecordShareScope
  granted    Boolean          @default(false)
  source     String           @default("CLINIC")
  capturedAt DateTime         @default(now())
  revokedAt  DateTime?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@unique([patientId, scope])
  @@index([tenantId, patientId])
}

/// SC-03 — effective consent per purpose (AI, marketplace, data processing).
model PatientConsent {
  id             String   @id @default(cuid())
  tenantId       String
  patientId      String
  patient        Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  purpose        String
  granted        Boolean
  source         String
  capturedAt     DateTime @default(now())
  signerName     String?
  signedOnTablet Boolean?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([patientId, purpose])
  @@index([tenantId, patientId])
}

/// GT-02 — versioned legal document acceptance per user/tenant
model LegalAcceptance {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  document   String
  version    String
  acceptedAt DateTime @default(now())
  ip         String?

  @@index([tenantId, userId, document])
  @@index([userId, document, version])
}

model MessagingConsent {
  id        String         @id @default(cuid())
  tenantId  String
  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patientId String
  patient   Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  channel   MessageChannel
  purpose   String
  granted   Boolean
  source    String
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([patientId, channel, purpose])
  @@index([tenantId, patientId])
}

model MessageTemplate {
  id        String         @id @default(cuid())
  tenantId  String
  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  key       String
  channel   MessageChannel
  subjectEn String?
  subjectAr String?
  bodyEn    String
  bodyAr    String
  active    Boolean        @default(true)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([tenantId, key, channel])
}

model OutboxEvent {
  id            String    @id @default(cuid())
  tenantId      String
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  aggregateType String
  aggregateId   String
  type          String
  payload       Json
  target        String    @default("KIOREX")
  status        String    @default("PENDING")
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now())
  createdAt     DateTime  @default(now())
  sentAt        DateTime?

  @@index([tenantId, status, createdAt])
  @@index([status, nextAttemptAt])
  @@index([aggregateType, aggregateId, createdAt])
}

model AppointmentRescheduleToken {
  id            String      @id @default(cuid())
  tenantId      String
  tenant        Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointmentId String      @unique
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  tokenHash     String      @unique
  expiresAt     DateTime
  usedAt        DateTime?
  createdAt     DateTime    @default(now())

  @@index([tenantId])
}

/// CL-03: short-lived pharmacy verification link printed as a QR on signed prescriptions.
model PrescriptionVerificationToken {
  id              String    @id @default(cuid())
  tenantId        String
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  encounterId     String
  encounter       Encounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  tokenHash       String    @unique
  expiresAt       DateTime
  createdByUserId String?
  revokedAt       DateTime?
  lastViewedAt    DateTime?
  viewCount       Int       @default(0)
  createdAt       DateTime  @default(now())

  @@index([tenantId])
  @@index([encounterId])
}

/// CL-05 append-only amendment trail. One row per Amend; resignedAt is set when the amended note is signed again.
model EncounterAmendment {
  id               String    @id @default(cuid())
  tenantId         String
  tenant           Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  encounterId      String
  encounter        Encounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  reason           String
  amendedByUserId  String?
  amendedByName    String
  amendedAt        DateTime  @default(now())
  wasLocked        Boolean   @default(false)
  resignedByUserId String?
  resignedByName   String?
  resignedAt       DateTime?

  @@index([tenantId])
  @@index([encounterId, amendedAt])
}

model WhatsAppInboundEvent {
  id                String   @id @default(cuid())
  tenantId          String
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  providerMessageId String   @unique
  appointmentId     String?
  action            String
  payloadJson       Json?
  createdAt         DateTime @default(now())

  @@index([tenantId, appointmentId])
}

/// MS-06 — WhatsApp AI receptionist conversation turn (Egyptian Arabic).
enum ReceptionistIntent {
  BOOKING
  RESCHEDULE
  PRICES
  LOCATION
  HOURS
  CLINICAL
  HANDOVER
  UNKNOWN
}

model WhatsAppReceptionistTurn {
  id                String             @id @default(cuid())
  tenantId          String
  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clinicId          String?
  fromPhone         String
  providerMessageId String?            @unique
  inboundText       String
  intent            ReceptionistIntent
  replyText         String
  handedOver        Boolean            @default(false)
  metadata          Json?
  createdAt         DateTime           @default(now())

  @@index([tenantId, createdAt])
  @@index([tenantId, handedOver, createdAt])
  @@index([fromPhone])
}

model OutboundMessage {
  id                String         @id @default(cuid())
  tenantId          String
  patientId         String?
  appointmentId     String?
  channel           MessageChannel
  templateKey       String?
  templateName      String?
  variablesJson     Json?
  toPhone           String
  body              String
  status            String         @default("QUEUED")
  providerMessageId String?        @unique
  failureClass      String?
  attemptCount      Int            @default(0)
  nextRetryAt       DateTime?
  metadata          Json?
  sentAt            DateTime?
  deliveredAt       DateTime?
  readAt            DateTime?
  error             String?
  createdAt         DateTime       @default(now())

  @@index([tenantId, status])
  @@index([tenantId, failureClass])
  @@index([appointmentId])
  @@index([patientId])
}

model RecallCampaign {
  id                 String                     @id @default(cuid())
  tenantId           String
  tenant             Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  kind               RecallCampaignKind
  nameEn             String
  nameAr             String                     @default("")
  acquisitionChannel PatientAcquisitionChannel?
  active             Boolean                    @default(true)
  createdAt          DateTime                   @default(now())

  @@index([tenantId, kind])
}

/// Retired by KX-08: Kiorex is the single source of reviews (see KiorexRating / KiorexReview). Kept read-only; no writers.
model SatisfactionSurveyResponse {
  id            String       @id @default(cuid())
  tenantId      String
  patientId     String
  patient       Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  appointmentId String?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  encounterId   String?
  clinicianId   String?
  score         Int
  comment       String?
  createdAt     DateTime     @default(now())

  @@index([tenantId, clinicianId])
}

model ClinicalIncident {
  id               String   @id @default(cuid())
  tenantId         String
  clinicId         String
  reportedByUserId String?
  severity         String   @default("LOW")
  summaryEn        String
  summaryAr        String   @default("")
  status           String   @default("OPEN")
  createdAt        DateTime @default(now())

  @@index([tenantId, clinicId])
}

model AiScribeSession {
  id                      String               @id @default(cuid())
  tenantId                String
  encounterId             String
  status                  String               @default("DRAFT")
  transcript              String?
  draftNote               Json?
  draftRx                 Json?
  /// Patient AI_PROCESSING consent captured before recording (MS AI-02).
  consentGrantedAt        DateTime?
  recordingStartedAt      DateTime?
  recordingStoppedAt      DateTime?
  /// Billed / metered audio length in whole seconds.
  audioSeconds            Int                  @default(0)
  /// Clinic opt-in to keep audio after sign-off (default delete).
  retainAudioAfterSignOff Boolean              @default(false)
  sttProvider             String?
  draftLatencyMs          Int?
  approvedAt              DateTime?
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt
  audioChunks             AiScribeAudioChunk[]

  @@index([tenantId, encounterId])
}

/// Transient audio chunks for AI-02; deleted on approve unless retainAudioAfterSignOff.
model AiScribeAudioChunk {
  id         String          @id @default(cuid())
  sessionId  String
  session    AiScribeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  seq        Int
  mimeType   String          @default("audio/webm")
  /// Base64 payload (dev/local). Production may swap to object storage keys.
  payloadB64 String
  byteLength Int
  createdAt  DateTime        @default(now())

  @@unique([sessionId, seq])
  @@index([sessionId])
}

model OtpChallenge {
  id         String    @id @default(cuid())
  phone      String
  purpose    String
  codeHash   String
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([phone, purpose])
}

model CreditWallet {
  id           String              @id @default(cuid())
  tenantId     String              @unique
  currency     String
  balance      Decimal             @default(0) @db.Decimal(14, 2)
  version      Int                 @default(0)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  entries      CreditLedgerEntry[]
  reservations CreditReservation[]
}

model CreditLedgerEntry {
  id             String          @id @default(cuid())
  walletId       String
  wallet         CreditWallet    @relation(fields: [walletId], references: [id], onDelete: Cascade)
  type           CreditEntryType
  reason         CreditReason
  amount         Decimal         @db.Decimal(14, 2)
  remaining      Decimal?        @db.Decimal(14, 2)
  expiresAt      DateTime?
  sourceRef      String?
  invoiceId      String?
  note           String?
  createdBy      String?
  createdAt      DateTime        @default(now())
  /// GRW-P2-W (migration 20261217100000): append-only, only `remaining` may change (database trigger).
  category       CreditCategory?
  campaignRef    String?
  restrictions   Json?
  idempotencyKey String?

  @@unique([walletId, idempotencyKey])
  @@index([walletId, createdAt])
  @@index([walletId, expiresAt])
  @@index([walletId, category])
}

/// GRW-P2-W: budget hold for a provider-sponsored patient promotion (reserve at booking, debit at completion). Opaque refs only: no patient column.
model CreditReservation {
  id              String                 @id @default(cuid())
  walletId        String
  wallet          CreditWallet           @relation(fields: [walletId], references: [id], onDelete: Cascade)
  tenantId        String
  amount          Decimal                @db.Decimal(14, 2)
  state           CreditReservationState @default(RESERVED)
  idempotencyKey  String
  promotionRef    String
  holdRef         String
  debitedAmount   Decimal?               @db.Decimal(14, 2)
  shortfall       Decimal?               @db.Decimal(14, 2)
  debitEntryId    String?
  reversalEntryId String?
  reservedAt      DateTime               @default(now())
  settledAt       DateTime?

  @@unique([walletId, idempotencyKey])
  @@index([walletId, state])
  @@index([promotionRef])
}

/// GRW-P2-W: prepaid usage units (never currency). Append-only by trigger.
model UsageUnitLedger {
  id              String   @id @default(cuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unit            String
  delta           Int
  reason          String
  idempotencyKey  String
  purchaseEntryId String?
  createdAt       DateTime @default(now())

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, unit])
}

/// GRW-P2-W: daily credit reconcile report.
model CreditReconcileRun {
  id         String   @id @default(cuid())
  ranAt      DateTime @default(now())
  wallets    Int
  repaired   Int
  expired    Int
  mismatches Int
  details    Json?

  @@index([ranAt])
}

model KiorlyInvoiceNumberSequence {
  id         String   @id @default(cuid())
  marketId   String
  market     Market   @relation(fields: [marketId], references: [id], onDelete: Cascade)
  year       Int
  lastNumber Int      @default(0)
  updatedAt  DateTime @updatedAt

  @@unique([marketId, year])
}

model KiorlyInvoice {
  id                      String                   @id @default(cuid())
  tenantId                String
  tenant                  Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  number                  String                   @unique
  periodKey               String
  periodStart             DateTime
  periodEnd               DateTime
  status                  KiorlyInvoiceStatus      @default(DRAFT)
  currency                String
  subtotal                Decimal                  @db.Decimal(14, 2)
  creditsApplied          Decimal                  @default(0) @db.Decimal(14, 2)
  tax                     Decimal                  @db.Decimal(14, 2)
  total                   Decimal                  @db.Decimal(14, 2)
  amountPaid              Decimal                  @default(0) @db.Decimal(14, 2)
  issuedAt                DateTime?
  dueAt                   DateTime?
  paidAt                  DateTime?
  etaUuid                 String?
  creditMemo              Boolean                  @default(false)
  voidOfInvoiceId         String?
  voidOfInvoice           KiorlyInvoice?           @relation("KiorlyInvoiceVoid", fields: [voidOfInvoiceId], references: [id], onDelete: SetNull)
  voidCredits             KiorlyInvoice[]          @relation("KiorlyInvoiceVoid")
  lines                   KiorlyInvoiceLine[]
  payments                KiorlyPayment[]
  kiorexCommissionCharges KiorexCommissionCharge[]
  paymentUnderReview      Boolean                  @default(false)
  autoChargeAttempts      Int                      @default(0)
  nextAutoChargeAt        DateTime?
  settlementSummaryJson   Json?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt

  @@unique([tenantId, periodKey])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@index([nextAutoChargeAt])
}

model KiorlyPaymentMethod {
  id                      String                  @id @default(cuid())
  tenantId                String
  tenant                  Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  provider                String
  kind                    KiorlyPaymentMethodKind
  tokenRef                String?
  brand                   String?
  last4                   String?
  expMonth                Int?
  expYear                 Int?
  isDefault               Boolean                 @default(false)
  createdAt               DateTime                @default(now())
  defaultForSubscriptions Subscription[]

  @@index([tenantId, isDefault])
  @@index([tenantId, provider])
}

model KiorlyPayment {
  id             String              @id @default(cuid())
  tenantId       String
  tenant         Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoiceId      String?
  invoice        KiorlyInvoice?      @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  provider       String
  providerRef    String              @unique
  amount         Decimal             @db.Decimal(14, 2)
  currency       String
  status         KiorlyPaymentStatus
  proofUploadKey String?
  verifiedBy     String?
  idempotencyKey String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@unique([provider, idempotencyKey])
  @@index([tenantId, createdAt])
  @@index([invoiceId, status])
}

model KiorlyPaymentWebhookEvent {
  id             String   @id @default(cuid())
  provider       String
  idempotencyKey String
  paymentId      String?
  payloadHash    String
  createdAt      DateTime @default(now())

  @@unique([provider, idempotencyKey])
}

model KiorlyInvoiceLine {
  id         String         @id @default(cuid())
  invoiceId  String
  invoice    KiorlyInvoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  type       KiorlyLineType
  descEn     String
  descAr     String
  quantity   Decimal        @db.Decimal(14, 2)
  unitAmount Decimal        @db.Decimal(14, 2)
  amount     Decimal        @db.Decimal(14, 2)
  refId      String?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@index([invoiceId])
}

model PasswordResetToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, createdAt])
}

/// MS-05 — transactional email (trial, Kiorly invoices, password reset, security) via SES.
model EmailMessage {
  id                String    @id @default(cuid())
  tenantId          String?
  tenant            Tenant?   @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  toEmail           String
  templateKey       String
  subject           String
  status            String    @default("QUEUED")
  provider          String?
  providerMessageId String?   @unique
  failureClass      String?
  bounceType        String?
  error             String?
  metadata          Json?
  sentAt            DateTime?
  bouncedAt         DateTime?
  createdAt         DateTime  @default(now())

  @@index([tenantId, status])
  @@index([toEmail, createdAt])
  @@index([status, createdAt])
}

model UserSession {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String
  expiresAt        DateTime
  revokedAt        DateTime?
  userAgent        String?
  ipHash           String?
  createdAt        DateTime  @default(now())
  lastSeenAt       DateTime  @default(now())
  /// KCV-201 — Kiorex Passport `sid` this session is bound to (back-channel logout revokes by sid).
  kiorexSid        String?

  @@index([userId, revokedAt])
  @@index([userId, expiresAt])
  @@index([kiorexSid])
}

/// FF03 — last-known Kiorex control-plane flag snapshot per product (fail-static persistence).
model KiorexFlagSnapshot {
  product       String    @id
  version       Int
  etag          String?
  payload       Json
  signature     String?
  generatedAt   DateTime
  fetchedAt     DateTime
  lastAttemptAt DateTime?
  lastError     String?
  updatedAt     DateTime  @updatedAt
}

/// FF06 — platform-level audit trail of snapshot changes (tenant-scoped AuditLog rows are written for org-scope changes).
model KiorexFlagAuditEvent {
  id          String   @id @default(cuid())
  product     String
  fromVersion Int?
  toVersion   Int
  source      String
  changes     Json
  createdAt   DateTime @default(now())

  @@index([product, createdAt])
}

/// KCV-201 — explicit, verified link between a Kiorly user and a Kiorex Passport subject (never auto-merged).
model KiorexIdentityLink {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  issuer        String
  subject       String
  /// How the link was verified, e.g. PASSWORD_REAUTH.
  linkedVia     String
  phoneVerified Boolean  @default(false)
  linkedAt      DateTime @default(now())

  @@unique([issuer, subject])
}

/// KCV-201 — jti of every accepted Kiorex Passport logout_token (back-channel-logout replay protection, shared by all API instances). Purged after the token's own expiry.
model KiorexLogoutTokenSeen {
  jti       String   @id
  seenAt    DateTime @default(now())
  expiresAt DateTime

  @@index([expiresAt])
}

/// KCV-201 — short-lived authorization-code + PKCE transaction (state is the primary key) and post-callback MFA ticket.
model KiorexOidcTransaction {
  state        String   @id
  nonce        String
  codeVerifier String
  /// LOGIN | LINK | MFA_TICKET
  mode         String
  userId       String?
  sid          String?
  /// ADR-031 / KNED: edition surface that started the sign-in (CLINIC | NURSE). Picks the redirect URI only; the client (aud = kiorly-clinic) is the same.
  edition      String?
  createdAt    DateTime @default(now())
  expiresAt    DateTime

  @@index([expiresAt])
}

/// Mock-mode dev inbox (CLAUDE.md: messaging and provider integrations are MOCKED by default). One row per rendered
/// outbound message (email / WhatsApp / SMS / push) and per simulated inbound reply. Written ONLY by mock adapters
/// (KIORLY_PROVIDER_MODE != real), never in real mode, so it never holds real-provider traffic.
model DevInboxMessage {
  id                String   @id @default(cuid())
  createdAt         DateTime @default(now())
  /// EMAIL | WHATSAPP | SMS | PUSH
  channel           String
  /// OUT (rendered by Kiorly) | IN (simulated inbound reply)
  direction         String   @default("OUT")
  tenantId          String?
  toAddress         String
  fromAddress       String?
  templateKey       String?
  subject           String?
  bodyText          String
  bodyHtml          String?
  variablesJson     Json?
  quickReplies      Json?
  documentLink      String?
  providerMessageId String?  @unique
  /// OutboundMessage.id / EmailMessage.id the row mirrors.
  relatedId         String?
  /// SENT | DELIVERED | READ | FAILED | BOUNCED | RECEIVED
  status            String   @default("SENT")
  statusHistory     Json     @default("[]")

  @@index([channel, createdAt])
  @@index([toAddress, createdAt])
  @@index([tenantId, createdAt])
}

/// CL07-PT04 — doctor's referral attached to / received for a physiotherapy patient.
model PhysioReferral {
  id                  String                @id @default(cuid())
  tenantId            String
  tenant              Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patientId           String
  /// ATTACHED_DOCUMENT | KIORLY_REFERRAL (ReferralIssued by consent) | DIRECT_ACCESS (only where the market pack allows, Q9)
  source              String
  referringDoctorName String?
  diagnosis           String?
  documentKey         String?
  /// ReferralIssued id for idempotent receipt.
  externalRef         String?               @unique
  createdByUserId     String?
  createdAt           DateTime              @default(now())
  plans               PhysioTreatmentPlan[]

  @@index([tenantId, patientId])
}

/// CL07-PT01 — initial assessment.
model PhysioAssessment {
  id              String   @id @default(cuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patientId       String
  clinicianId     String
  encounterId     String?
  complaint       String
  history         String   @default("")
  painNrs         Int
  rom             Json     @default("[]")
  strength        Json     @default("[]")
  specialTests    Json     @default("[]")
  functionalGoals Json     @default("[]")
  createdAt       DateTime @default(now())

  @@index([tenantId, patientId])
}

/// CL07-PT02 — treatment plan; sold as a package (MN01 PatientServicePackage) with a session counter.
model PhysioTreatmentPlan {
  id                String               @id @default(cuid())
  tenantId          String
  tenant            Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patientId         String
  clinicianId       String
  clinicId          String?
  referralId        String?
  referral          PhysioReferral?      @relation(fields: [referralId], references: [id], onDelete: SetNull)
  assessmentId      String?
  packageId         String?
  seriesId          String?
  sessionCount      Int
  sessionsCompleted Int                  @default(0)
  frequencyPerWeek  Int
  modalities        Json                 @default("[]")
  homeProgramme     Json                 @default("[]")
  /// ACTIVE | DISCHARGED
  status            String               @default("ACTIVE")
  dischargeSummary  String?
  dischargedAt      DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  notes             PhysioProgressNote[]
  hepLinks          PhysioHepLink[]

  @@index([tenantId, patientId])
}

/// CL07-PT03 — progress note per session.
model PhysioProgressNote {
  id            String              @id @default(cuid())
  tenantId      String
  planId        String
  plan          PhysioTreatmentPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  patientId     String
  clinicianId   String
  appointmentId String?
  sessionNo     Int
  subjective    String              @default("")
  intervention  String              @default("")
  response      String              @default("")
  nextPlan      String              @default("")
  createdAt     DateTime            @default(now())

  @@unique([planId, sessionNo])
  @@index([tenantId, patientId])
}

/// CL07-PT01/03 — outcome measure points for trend charts (pain, ROM, strength, function scores).
model PhysioOutcomeMeasure {
  id         String   @id @default(cuid())
  tenantId   String
  patientId  String
  planId     String?
  /// PAIN_NRS | ROM | STRENGTH | FUNCTION
  kind       String
  /// Joint / movement / scale name, e.g. "knee_flexion", "ODI".
  label      String
  side       String?
  value      Decimal  @db.Decimal(8, 2)
  unit       String
  measuredAt DateTime @default(now())

  @@index([tenantId, patientId, kind, label])
}

/// CL07-PT05 — hashed share token for the home exercise programme page (no PHI on the page or in the message).
model PhysioHepLink {
  id        String              @id @default(cuid())
  tenantId  String
  planId    String
  plan      PhysioTreatmentPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  tokenHash String              @unique
  expiresAt DateTime
  sharedAt  DateTime?
  createdAt DateTime            @default(now())
}

// ---------------------------------------------------------------------------------------------------------------
// Rev 2.3 — home visits (ADR-030, HV*) and the Nurse edition (ADR-031, KN*)
// ---------------------------------------------------------------------------------------------------------------

enum ServiceLocation {
  IN_CLINIC
  HOME
  /// ADR-039 — telehealth video visit (P2P WebRTC). Exposed as visitType TELEHEALTH in DTOs.
  VIDEO
}

enum TelehealthSessionStatus {
  SCHEDULED
  WAITING
  ACTIVE
  ENDED
  CANCELLED
  MISSED
}

enum TelehealthMode {
  VIDEO
  AUDIO
}

enum TelehealthRole {
  CLINICIAN
  PATIENT
}

enum TelehealthSignalType {
  OFFER
  ANSWER
  ICE_CANDIDATE
  BYE
  RENEGOTIATE
}

/// ADR-039 — one telehealth session per appointment. The join window is NEVER stored: it is computed at join time from the
/// appointment's current start/end. The patient link token carries only {sessionId, patientId, linkVersion}.
model TelehealthSession {
  id                  String                  @id @default(cuid())
  tenantId            String
  tenant              Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clinicId            String
  appointmentId       String                  @unique
  appointment         Appointment             @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  patientId           String
  clinicianUserId     String
  status              TelehealthSessionStatus @default(SCHEDULED)
  mode                TelehealthMode          @default(VIDEO)
  /// Incremented by "Regenerate link": tokens carrying an older version are rejected.
  linkVersion         Int                     @default(1)
  clinicianJoinedAt   DateTime?
  patientJoinedAt     DateTime?
  /// Heartbeats (every poll); a participant counts as present while lastSeen is recent.
  clinicianLastSeenAt DateTime?
  patientLastSeenAt   DateTime?
  startedAt           DateTime?
  /// Both participants present since this instant (reset when one drops); attendance = now - bothActiveSince >= threshold.
  bothActiveSince     DateTime?
  /// Exactly-once guard for attendance (check-in + commission + encounter).
  attendedAt          DateTime?
  endedAt             DateTime?
  endReason           String?
  missedAt            DateTime?
  /// MISSED because the doctor never showed: appointment kept open, flagged for staff review, patient not charged.
  needsStaffReview    Boolean                 @default(false)
  /// Per-reminder state {"24h":{"startsAt":iso,"linkVersion":n},"15m":{...}}: dedupe per linkVersion, re-armed by a moved start.
  reminderState       Json?
  signalSeq           Int                     @default(0)
  createdByUserId     String?
  signals             TelehealthSignal[]
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  @@index([tenantId, status])
  @@index([tenantId, clinicianUserId])
  @@index([status, updatedAt])
}

/// ADR-039 — WebRTC signaling messages (SDP/ICE only, no PHI). seq is monotonic per session; rows older than 24 h are purged.
model TelehealthSignal {
  id        String               @id @default(cuid())
  sessionId String
  session   TelehealthSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  fromRole  TelehealthRole
  type      TelehealthSignalType
  payload   Json
  seq       Int
  createdAt DateTime             @default(now())

  @@unique([sessionId, seq])
  @@index([createdAt])
}

/// ADR-039 — per-doctor telehealth switch and optional telehealth-only availability windows
/// ({"mon":[{"start":"09:00","end":"12:00"}],...} in clinic local time). Durations/prices per service come from
/// AppointmentType (serviceLocation VIDEO) and ClinicianAppointmentTypeOverride.
model ClinicianTelehealthSetting {
  tenantId         String
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clinicianId      String
  clinician        User     @relation("ClinicianTelehealth", fields: [clinicianId], references: [id], onDelete: Cascade)
  offersTelehealth Boolean  @default(false)
  windowsJson      Json?
  updatedAt        DateTime @updatedAt

  @@id([clinicianId])
  @@index([tenantId, offersTelehealth])
}

enum OrganizationEdition {
  CLINIC
  NURSE
}

enum HomeVisitState {
  REQUESTED
  CONFIRMED
  ON_MY_WAY
  ARRIVED
  FINISHED
  ABORTED_UNSAFE
  CANCELLED
  NO_SHOW
}

enum HomeSafetyAlertKind {
  NO_ANSWER
  SOS
  UNSAFE_ABORT
}

/// HVCFG02/03 + HVBK06 — one row per clinician: coverage districts, optional travel cap, daily cap, hours and gender restriction (BR60).
model ClinicianHomeSettings {
  id                      String   @id @default(cuid())
  tenantId                String
  tenant                  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clinicianId             String
  acceptsHomeVisits       Boolean  @default(true)
  coverageDistrictIds     String[] @default([])
  maxTravelMinutes        Int?
  startDistrictId         String?
  dailyVisitCap           Int?
  /// { "mon": [["09:00","17:00"]], ... } clinic-local time; null = the clinician's normal availability template.
  homeHoursJson           Json?
  /// BR60 — clinician-owned: only patients of this gender may book home visits (M | F); null = no restriction.
  restrictToPatientGender Gender?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@unique([tenantId, clinicianId])
}

/// HVBK03/HVPRV01 — the home-visit fact for an appointment. The address is AES-256-GCM ciphertext; `districtId` stays in clear (coarse, analytics-safe).
model HomeVisit {
  id                 String              @id @default(cuid())
  tenantId           String
  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clinicId           String
  appointmentId      String              @unique
  appointment        Appointment         @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  patientId          String
  clinicianId        String?
  state              HomeVisitState      @default(REQUESTED)
  districtId         String
  addressCiphertext  String?
  /// Set when the 24 h masking (BR52) job (or a read past the window) wipes the ciphertext.
  addressMaskedAt    DateTime?
  addressConfirmedAt DateTime?
  plannedStartsAt    DateTime
  plannedEndsAt      DateTime
  enRouteAt          DateTime?
  arrivedAt          DateTime?
  /// Distance (metres) between the arrival fix and the visit address coordinates; null when either has no coordinates. Never blocks the arrival.
  arrivalDistanceM   Int?
  /// Non-blocking dispatcher/owner flag: arrival fix farther than HOME_VISIT_ARRIVAL_THRESHOLD_M from the address. Never shown to the patient.
  arrivedOffSite     Boolean             @default(false)
  finishedAt         DateTime?
  endedAt            DateTime?
  abortReason        String?
  surchargeAmount    Decimal?            @db.Decimal(14, 2)
  /// HVSAF01 state machine timestamps (see @kiorly/field-visit SafetyState).
  safetyPromptSentAt DateTime?
  safetyAnsweredAt   DateTime?
  safetyAlertSentAt  DateTime?
  /// KNAG — who assigned the clinician (dispatcher) and when.
  assignedById       String?
  assignedAt         DateTime?
  geostamps          HomeVisitGeostamp[]
  alerts             HomeSafetyAlert[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([tenantId, clinicianId, plannedStartsAt])
  @@index([tenantId, state])
  @@index([endedAt, addressMaskedAt])
}

/// HVEXE01 — coarse (~1 km) stamps per state change; lat/lng wiped after 12 months, district kept (geostamp retention purge).
model HomeVisitGeostamp {
  id         String    @id @default(cuid())
  tenantId   String
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  visitId    String
  visit      HomeVisit @relation(fields: [visitId], references: [id], onDelete: Cascade)
  /// Lifecycle state the stamp belongs to (ON_MY_WAY, ARRIVED, FINISHED, ABORTED_UNSAFE, SOS).
  kind       String
  lat        Float?
  lng        Float?
  districtId String?
  recordedAt DateTime  @default(now())
  /// Set when lat/lng were removed by the retention purge.
  purgedAt   DateTime?

  @@index([tenantId, recordedAt])
  @@index([visitId])
  @@index([purgedAt, recordedAt])
}

/// HVSAF01/02 — a delivered (or failing) safety alert. Contains NO address and NO patient data.
model HomeSafetyAlert {
  id              String              @id @default(cuid())
  tenantId        String
  tenant          Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  visitId         String
  visit           HomeVisit           @relation(fields: [visitId], references: [id], onDelete: Cascade)
  kind            HomeSafetyAlertKind
  raisedAt        DateTime
  dueAt           DateTime
  deliveredAt     DateTime?
  deliveryChannel String?
  latencyMs       Int?
  withinSla       Boolean             @default(false)
  /// DELIVERED | FAILED (on-call paged) | ACKNOWLEDGED | RESOLVED | ESCALATED
  status          String              @default("PENDING")
  acknowledgedAt  DateTime?
  resolvedAt      DateTime?
  escalatedAt     DateTime?
  createdAt       DateTime            @default(now())

  @@index([tenantId, status, raisedAt])
  @@index([visitId])
}

/// KNAG01/03/04 — roster attributes for agency nurses (and aides, who are never sent alone or listed).
model NurseRosterProfile {
  id              String   @id @default(cuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId          String
  skills          String[] @default([])
  languages       String[] @default([])
  /// KNAG03 — pay per finished visit / per shift hour, agency-owned (never paid by Kiorex Pay).
  payPerVisit     Decimal? @db.Decimal(14, 2)
  payPerShiftHour Decimal? @db.Decimal(14, 2)
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([tenantId, userId])
}

/// KNCP01-03 — care plan = services × frequency × duration; generates recurring home visits through the slot engine.
model CarePlan {
  id               String          @id @default(cuid())
  tenantId         String
  tenant           Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clinicId         String
  patientId        String
  /// Primary assigned nurse (agencies may reassign per visit).
  nurseId          String?
  title            String
  /// ACTIVE | PAUSED | ENDED
  status           String          @default("ACTIVE")
  startDate        DateTime        @db.Date
  /// [{ appointmentTypeId, frequencyPerWeek | everyDays, durationDays, timeOfDay "HH:mm" }]
  itemsJson        Json
  visitsTotal      Int             @default(0)
  visitsDone       Int             @default(0)
  /// KNCP02 — MN01 package that prices the plan (deposit, instalments or pay-per-visit).
  servicePackageId String?
  endedAt          DateTime?
  dischargeNote    String?
  /// Kiorex care-plan request this plan answers (P3, idempotent); CARE_PLAN_CONFIRMED / _ENDED are emitted only for plans with a requestRef.
  requestRef       String?         @unique
  /// KNCP03 — record shared to the patient's Kiorex vault only by consent.
  sharedToVaultAt  DateTime?
  createdById      String?
  visits           CarePlanVisit[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([tenantId, patientId])
  @@index([tenantId, status])
}

model CarePlanVisit {
  id            String   @id @default(cuid())
  carePlanId    String
  carePlan      CarePlan @relation(fields: [carePlanId], references: [id], onDelete: Cascade)
  appointmentId String   @unique
  sequence      Int
  createdAt     DateTime @default(now())

  @@index([carePlanId])
}

/// KNREC01 — nursing visit record: checklist, assessment / intervention / evaluation. Signed and auto-locked like encounters (CL05).
model VisitRecord {
  id                 String                     @id @default(cuid())
  tenantId           String
  tenant             Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointmentId      String                     @unique
  patientId          String
  nurseId            String
  carePlanId         String?
  /// [{ task, done, note? }]
  checklistJson      Json                       @default("[]")
  assessment         String?
  intervention       String?
  evaluation         String?
  freeText           String?
  /// nurse.mar OFF → medication recorded as free text here (KX-23 §07).
  medicationFreeText String?
  /// DRAFT | SIGNED (locked; amendments are versioned elsewhere like encounters)
  status             String                     @default("DRAFT")
  signedAt           DateTime?
  lockedAt           DateTime?
  vitals             VitalsObservation[]
  administrations    MedicationAdministration[]
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt

  @@index([tenantId, patientId])
  @@index([tenantId, nurseId])
}

/// KNREC02/KNESC01 — vitals with out-of-range flags (thresholds from the market pack, CMO-signed) and escalation log.
model VitalsObservation {
  id               String       @id @default(cuid())
  tenantId         String
  tenant           Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patientId        String
  visitRecordId    String?
  visitRecord      VisitRecord? @relation(fields: [visitRecordId], references: [id], onDelete: SetNull)
  recordedById     String
  recordedAt       DateTime     @default(now())
  systolic         Int?
  diastolic        Int?
  pulse            Int?
  temperatureC     Decimal?     @db.Decimal(4, 1)
  spo2             Int?
  respiratoryRate  Int?
  glucoseMgDl      Int?
  painScore        Int?
  /// { systolic: "HIGH" | "LOW" | "CRITICAL_HIGH" | "CRITICAL_LOW", ... }
  flagsJson        Json         @default("{}")
  critical         Boolean      @default(false)
  /// KNESC01 — action taken after a critical value (CALLED_DOCTOR | CALLED_123 | MONITORING | OTHER) and when.
  escalationAction String?
  escalationNote   String?
  escalatedAt      DateTime?

  @@index([tenantId, patientId, recordedAt])
}

/// KNMAR02/03 — the doctor's order every administration is recorded against (BR57). Never optional.
model DoctorOrder {
  id                 String                     @id @default(cuid())
  tenantId           String
  tenant             Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patientId          String
  /// SHARED_KIORLY (MedicationOrderShared by consent) | PHOTO_UPLOAD (nurse confirms prescriber name and date)
  source             String
  prescriberName     String
  orderedOn          DateTime                   @db.Date
  expiresOn          DateTime                   @db.Date
  /// BR35 — controlled medicines need an order marked controlled and a witness; never supplied through Kiorex.
  controlled         Boolean                    @default(false)
  /// [{ medicineName, drugProductId?, dose, route, frequency }]
  linesJson          Json
  documentKey        String?
  /// MedicationOrderShared id (idempotent receipt) and its signed order version.
  externalRef        String?                    @unique
  orderVersion       String?
  /// ACTIVE | REVOKED. Expiry is derived from expiresOn and enforced on every administration.
  status             String                     @default("ACTIVE")
  confirmedByNurseId String?
  confirmedAt        DateTime?
  createdAt          DateTime                   @default(now())
  administrations    MedicationAdministration[]

  @@index([tenantId, patientId])
}

/// KNMAR01 — one medication administration. `doctorOrderId` is mandatory: no order, no row (ADR-025 safety control).
model MedicationAdministration {
  id              String       @id @default(cuid())
  tenantId        String
  tenant          Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patientId       String
  visitRecordId   String?
  visitRecord     VisitRecord? @relation(fields: [visitRecordId], references: [id], onDelete: SetNull)
  doctorOrderId   String
  doctorOrder     DoctorOrder  @relation(fields: [doctorOrderId], references: [id], onDelete: Restrict)
  medicineName    String
  drugProductId   String?
  dose            String
  route           String
  administeredAt  DateTime
  nurseId         String
  witnessUserId   String?
  witnessName     String?
  /// Result of the allergy + duplicate checks that ran on this entry (never skippable).
  safetyCheckJson Json         @default("{}")
  createdAt       DateTime     @default(now())

  @@index([tenantId, patientId, administeredAt])
  @@index([doctorOrderId])
}

/// KNSH01 — private-duty shifts (8 / 12 / 24 h) with geostamped check-in/out and a handover note.
model ShiftBooking {
  id                String    @id @default(cuid())
  tenantId          String
  tenant            Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patientId         String
  nurseId           String
  startsAt          DateTime
  endsAt            DateTime
  durationHours     Int
  /// BOOKED | IN_PROGRESS | COMPLETED | CANCELLED
  status            String    @default("BOOKED")
  checkInAt         DateTime?
  checkInLat        Float?
  checkInLng        Float?
  checkOutAt        DateTime?
  checkOutLat       Float?
  checkOutLng       Float?
  handoverNote      String?
  /// Next nurse who receives the handover.
  handoverToNurseId String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([tenantId, nurseId, startsAt])
  @@index([tenantId, patientId])
}

/// KX-09 §03 (P3 draft) — a multi-visit care plan requested through POST /marketplace/v1/care-plan-requests. Idempotent on requestRef.
/// Inbox row for the nurse / agency: accepting it creates a CarePlan (same requestRef); declining answers DECLINED. The visit address is stored encrypted (HVPRV01).
model CarePlanRequest {
  id                     String    @id @default(cuid())
  tenantId               String
  tenant                 Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clinicId               String
  clinicianId            String?
  typeId                 String?
  requestRef             String    @unique
  preferredStartDate     DateTime? @db.Date
  notes                  String?
  visitAddressCiphertext String?
  patientPhone           String
  patientFirstName       String
  patientLastName        String
  /// RECEIVED | ACCEPTED | DECLINED
  status                 String    @default("RECEIVED")
  carePlanId             String?
  declineReason          String?
  decidedById            String?
  decidedAt              DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@index([tenantId, status, createdAt])
}

/// KNLAB01 / KLORD05 — a sample the nurse collected against a LAB order, handed to Kiorly Lab through Kiorex (`LabOrderPlaced`).
/// Stores identifier KINDS (never values), the SHA-256 of the consent token, and the lab status/custody mirror pushed back by Kiorex (no PHI, no results).
model LabSampleCollection {
  id                 String          @id @default(cuid())
  tenantId           String
  tenant             Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orderId            String          @unique
  order              ClinicalOrder   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  patientId          String
  /// The home visit this was collected on (the event's visitRef); null for a collection recorded outside a visit.
  appointmentId      String?
  collectorUserId    String
  collectedAt        DateTime
  handedOverAt       DateTime?
  temperatureC       Decimal?        @db.Decimal(4, 1)
  /// ["FULL_NAME","DATE_OF_BIRTH"]: which identifiers were checked against the patient record (never the values).
  identifiersChecked Json
  consentTokenHash   String
  prescriberName     String?
  outboxEventId      String?
  /// Mirror of the Kiorex push (POST /marketplace/v1/lab-orders/:orderId/status). RECEIVED_BY_KIOREX until the lab answers.
  labStatus          String          @default("HANDED_OFF")
  labOrderNumber     String?
  labId              String?
  labStatusAt        DateTime?
  rejectionCode      String?
  /// [{ label, type, occurredAt, by: NURSE|LAB, temperatureC }]
  custodyJson        Json?
  reportId           String?
  reportVersion      Int?
  resultSecureLink   String?
  resultReleasedAt   DateTime?
  tubes              LabSampleTube[]
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@index([tenantId, patientId])
  @@index([tenantId, appointmentId])
}

model LabSampleTube {
  id           String              @id @default(cuid())
  tenantId     String
  collectionId String
  collection   LabSampleCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  /// Barcode on the physical tube; unique per tenant (the lab enforces uniqueness per lab).
  label        String
  specimenType String
  container    String?

  @@unique([tenantId, label])
  @@index([collectionId])
}

enum MobileDeviceStatus {
  ACTIVE
  REVOKED
}

/// Kiorly staff app: one row per (user, device). The device-bound token is stored hashed (sha256), never in clear.
model MobileDevice {
  id           String             @id @default(cuid())
  tenantId     String
  userId       String
  /// Client-generated UUID, stable per app install.
  deviceId     String
  platform     String
  name         String
  appVersion   String?
  tokenHash    String
  status       MobileDeviceStatus @default(ACTIVE)
  /// The refresh session (UserSession.id) this device signed in with; revoking the device revokes it (remote sign-out).
  sessionId    String?
  pushToken    String?
  pushProvider String?
  lastSeenAt   DateTime?
  revokedAt    DateTime?
  revokedBy    String?
  createdAt    DateTime           @default(now())

  @@unique([userId, deviceId])
  @@index([tenantId, status])
}

/// Mock push sender output = the staff in-app inbox (MOBILE_PUSH_MODE=mock). Bilingual, no raw clinical values.
model MobilePush {
  id          String    @id @default(cuid())
  tenantId    String
  userId      String
  /// GENERAL | SAFETY | CLINICAL | OPS
  kind        String
  templateId  String
  title       String
  titleAr     String
  body        String
  bodyAr      String
  data        Json      @default("{}")
  status      String    @default("DELIVERED")
  provider    String    @default("mock")
  createdAt   DateTime  @default(now())
  deliveredAt DateTime?
  readAt      DateTime?

  @@index([userId, createdAt])
  @@index([tenantId, userId, readAt])
}

/// Acknowledgement note of a derived safety alert (ADR-025: read + acknowledge works on every plan).
model MobileAlertAck {
  id       String   @id @default(cuid())
  tenantId String
  alertKey String
  ackedBy  String
  note     String?
  ackedAt  DateTime @default(now())

  @@unique([tenantId, alertKey])
}

/// Kiorly: a staff member asked their org owner/admin to upgrade to a plan that includes `mobile_staff_app`. Allowed on Basic (not entitlement-gated).
/// Repeat requests by the same user for the same feature within 24h are de-duplicated by the service.
model MobileUpgradeRequest {
  id            String   @id @default(cuid())
  tenantId      String
  userId        String
  role          String
  /// A module key (e.g. clinic.vitals) or "general".
  featureKey    String
  plan          String
  note          String?
  status        String   @default("OPEN")
  notifiedCount Int      @default(0)
  createdAt     DateTime @default(now())

  @@index([tenantId, userId, featureKey, createdAt])
  @@index([tenantId, status, createdAt])
}

/// Doctor review (approval) of a lab/imaging result from the staff app.
model MobileResultReview {
  id         String   @id @default(cuid())
  tenantId   String
  orderId    String
  reviewedBy String
  note       String?
  reviewedAt DateTime @default(now())

  @@unique([tenantId, orderId])
}

/// Kiorex org-onboarding import (HMAC receiver): one Clinic organization (tenant + clinic) provisioned per (integration client, Kiorex org ref).
model KiorexImportOrg {
  id             String   @id @default(cuid())
  clientId       String
  kiorexOrgId    String
  tenantId       String
  clinicId       String
  importerUserId String
  createdAt      DateTime @default(now())

  batches KiorexImportBatch[]

  @@unique([clientId, kiorexOrgId])
  @@index([tenantId])
}

/// One Kiorex import batch; every row it created is listed in KiorexImportItem so the whole batch can be rolled back.
model KiorexImportBatch {
  id            String          @id @default(cuid())
  orgRowId      String
  org           KiorexImportOrg @relation(fields: [orgRowId], references: [id], onDelete: Cascade)
  clientId      String
  kiorexBatchId String
  tenantId      String
  status        String          @default("OPEN") // OPEN | ROLLED_BACK
  createdAt     DateTime        @default(now())
  rolledBackAt  DateTime?

  items KiorexImportItem[]

  @@unique([clientId, kiorexBatchId])
}

/// Idempotency + rollback ledger. `created=false` means the target row already existed (de-duplicated) and must survive a rollback.
model KiorexImportItem {
  id             String            @id @default(cuid())
  batchRowId     String
  batch          KiorexImportBatch @relation(fields: [batchRowId], references: [id], onDelete: Cascade)
  tenantId       String
  entity         String
  idempotencyKey String
  sourceKey      String
  targetId       String
  created        Boolean           @default(true)
  storageKey     String?
  createdAt      DateTime          @default(now())

  @@unique([batchRowId, idempotencyKey])
  @@index([batchRowId, entity])
}

/// Kiorly Home sign-in handoff (ADR-038): a single-use, 30-second code that Home gets after a password check and the product web redeems for the normal session.
/// Kiorly Home sign-in handoff (ADR-038): a single-use, 30-second code that Home gets after a password check and the product web redeems for the normal session.
/// Only the SHA-256 hash of the code is stored; `subjectId` is the User.id; `origin` is the Home origin it was issued for.
model HandoffCode {
  id        String    @id @default(cuid())
  codeHash  String    @unique
  product   String
  edition   String?
  origin    String
  subjectId String
  createdAt DateTime  @default(now())
  expiresAt DateTime
  usedAt    DateTime?

  @@index([expiresAt])
}

// ───────────────────────── growth engine: provider links, widget settings, commission decisions (GRW-P1-D0, ARCH sections 4.2, 6.7, 11) ─────────────────────────
// Links work standalone (no Kiorex connection needed) and never carry a Kiorex fee. KiorexCommissionDecision is append-only (DB trigger in migration 20261128110000_growth_links_attribution).

enum ReferralLinkOwnerScope {
  ORG
  CLINIC
  BRANCH
  DOCTOR
  DESK
}

enum ReferralLinkChannelKind {
  WEB_LINK
  QR_POSTER
  QR_DESK
  SOCIAL
  SMS
  WHATSAPP_SHARE
  EMAIL_SIG
  GOOGLE_PROFILE
}

enum ReferralLinkStatus {
  ACTIVE
  PAUSED
  REVOKED
}

/// Commission-relevant acquisition origin (ARCH 6.1). Mirrors @kiorex/contracts ACQUISITION_ORIGINS; Clinic keeps its own copy (src/growth/acquisition-contract.ts).
enum AcquisitionOrigin {
  PROVIDER_LED
  MARKETPLACE
  UNATTRIBUTED
}

enum CommissionDecisionKind {
  CHARGE
  NO_CHARGE
  WAIVED
}

/// A provider-owned tracking link or QR. `code` is 8 Crockford base32 characters (no I, L, O, U), globally unique; branchRef is a child Clinic id.
model ProviderReferralLink {
  id          String                  @id @default(cuid())
  tenantId    String
  tenant      Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clinicId    String
  clinic      Clinic                  @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  clinicianId String?
  branchRef   String?
  deskLabel   String?
  ownerScope  ReferralLinkOwnerScope  @default(CLINIC)
  channelKind ReferralLinkChannelKind @default(WEB_LINK)
  code        String                  @unique
  label       String
  status      ReferralLinkStatus      @default(ACTIVE)
  /// GRW-P1-D1: campaign and UTM tags ({ utm_source, utm_medium, utm_campaign, utm_content, campaign }), each a short [a-z0-9_.-] token. Never patient data.
  tags        Json?
  createdBy   String
  revokedAt   DateTime?
  revokedBy   String?
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  daily ProviderReferralLinkDaily[]

  @@index([tenantId, status])
  @@index([clinicId, status])
}

/// Counters only (never patient data): visits counted without cookies, bookings and attended derived from appointments carrying the link.
model ProviderReferralLinkDaily {
  linkId    String
  link      ProviderReferralLink @relation(fields: [linkId], references: [id], onDelete: Cascade)
  tenantId  String
  date      DateTime             @db.Date
  visits    Int                  @default(0)
  bookings  Int                  @default(0)
  attended  Int                  @default(0)
  updatedAt DateTime             @updatedAt

  @@id([linkId, date])
  @@index([tenantId, date])
}

/// Org-owned widget settings. allowedOrigins: JSON array of exact https origins, at most 10 (CHECK in the migration); changes are audited by D1 and projected to Kiorex as PROVIDER_PROFILE_UPDATED.widgetOrigins.
model BookingWidgetConfig {
  id             String   @id @default(cuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clinicId       String   @unique
  clinic         Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  enabled        Boolean  @default(false)
  allowedOrigins Json     @default("[]")
  theme          String   @default("auto")
  locale         String   @default("ar")
  /// GRW-P1-D1: { brandColor?, languages: ("ar"|"en")[], doctorIds: string[] (empty = all listed doctors), branchIds: string[] (empty = all) }.
  settings       Json     @default("{}")
  updatedBy      String?
  updatedAt      DateTime @updatedAt
  createdAt      DateTime @default(now())

  @@index([tenantId])
}

/// Append-only explanation of why a Kiorex fee was or was not applied (1:1 per appointment and policy version). Written by the commission service at check-in.
model KiorexCommissionDecision {
  id                     String                 @id @default(cuid())
  tenantId               String
  clinicId               String
  appointmentId          String
  appointment            Appointment            @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  policyVersion          String
  origin                 AcquisitionOrigin
  bookingSource          BookingSource
  isNewPatient           Boolean
  decision               CommissionDecisionKind
  reasonCodes            String[]
  rateId                 String?
  amount                 Decimal?               @db.Decimal(14, 2)
  currency               String?
  inputsHash             String
  createdAt              DateTime               @default(now())
  /// GRW-P2-S (additive, contracts 1.12.0): the fee the Kiorex fee was computed on, before any sponsored discount; reference fields only, NOT part of inputsHash.
  feeBasisMinor          Int?
  sponsoredDiscountMinor Int?
  basisPolicyVersion     String?

  @@unique([appointmentId, policyVersion])
  @@index([tenantId, createdAt])
  @@index([clinicId, createdAt])
}

/// Shared rate-limit counters (PgRateLimiter): one row per (key|windowMs, aligned window). Backs the sign-in and client-secret throttles across API instances; expired rows are swept opportunistically.
model RateLimitBucket {
  key         String
  windowStart DateTime
  count       Int
  expiresAt   DateTime

  @@id([key, windowStart])
  @@index([expiresAt])
}

/// Marketplace HMAC nonces already seen (KX-PT-L1): a signed request replayed on ANOTHER API instance inside the skew window is refused as well. Expired rows are swept opportunistically.
model MarketplaceNonce {
  clientId  String
  nonce     String
  expiresAt DateTime

  @@id([clientId, nonce])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------------------------------
// GRW-P2-C provider marketing portal completion (contracts 1.12.0). Counts and references only; no patient data anywhere.
// ---------------------------------------------------------------------------------------------------

enum SocialTemplateKind {
  POST
  STORY
  FLYER
  WHATSAPP_MESSAGE
  SMS_TEXT
}

enum SocialTemplateStatus {
  DRAFT
  PUBLISHED
  RETIRED
}

enum ProviderRecommendationStatus {
  OPEN
  DISMISSED
  SNOOZED
  DONE
}

enum VerificationUpdateField {
  LICENSE_NUMBER
  SPECIALTY
  ADDRESS
  DISPLAY_NAME
  PHOTO
  DOCUMENT
}

enum VerificationUpdateStatus {
  SUBMITTED
  NEEDS_INFO
  APPROVED
  REJECTED
  WITHDRAWN
}

enum StatementExportKind {
  PDF
  CSV
}

/// Platform-authored, approved wording (no tenant column). `slug` groups the AR and EN renditions of one template; `protectedFooter` is appended by the renderer and cannot be edited by providers.
model SocialContentTemplate {
  id              String               @id @default(cuid())
  slug            String
  kind            SocialTemplateKind
  locale          String
  title           String
  body            String
  layoutKey       String               @default("plain")
  protectedFooter String
  status          SocialTemplateStatus @default(DRAFT)
  version         Int                  @default(1)
  createdBy       String               @default("system")
  createdAt       DateTime             @default(now())

  @@unique([slug, locale, version])
  @@index([status, kind, locale])
