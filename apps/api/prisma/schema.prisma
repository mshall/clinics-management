model FiscalDocument {
  id             String            @id @default(cuid())
  tenantId       String
  tenant         Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clinicId       String
  clinic         Clinic            @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patientId      String
  patient        Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  fiscalDeviceId String?
  fiscalDevice   FiscalDevice?     @relation(fields: [fiscalDeviceId], references: [id], onDelete: SetNull)
  providerKey    String
  paymentId      String?           @unique
  payment        BillingPayment?   @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  revenueEntryId String?           @unique
  revenueEntry   RevenueEntry?     @relation(fields: [revenueEntryId], references: [id], onDelete: SetNull)
  invoiceId      String?           @unique
  invoice        Invoice?          @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  currency       String
  totalAmount    Decimal           @db.Decimal(14, 2)
  payloadJson    Json?
  schemaVersion  String            @default("1")
  createdAt      DateTime          @default(now())
  submission     FiscalSubmission?
}

model FiscalSubmission {
  id                       String                 @id @default(cuid())
  tenantId                 String
  tenant                   Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clinicId                 String
  clinic                   Clinic                 @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patientId                String
  patient                  Patient                @relation(fields: [patientId], references: [id], onDelete: Cascade)
  fiscalDocumentId         String                 @unique
  fiscalDocument           FiscalDocument         @relation(fields: [fiscalDocumentId], references: [id], onDelete: Cascade)
  fiscalDeviceId           String?
  fiscalDevice             FiscalDevice?          @relation(fields: [fiscalDeviceId], references: [id], onDelete: SetNull)
  providerKey              String
  deviceId                 String?
  receiptNumber            Int?
  status                   FiscalSubmissionStatus @default(PENDING)
  providerDocumentUuid     String?
  payloadJson              Json?
  signature                String?
  idempotencyKey           String?                @unique
  submittedAt              DateTime?
  errorMessage             String?
  submitAttempts           Int                    @default(0)
  nextRetryAt              DateTime?
  claimedUntil             DateTime?
  claimedBy                String?
  /**
   * ETA acceptance vs later validity (VALID, INVALID, PENDING, UNKNOWN)
   */
  providerValidationStatus String                 @default("PENDING")
  updatedAt                DateTime               @updatedAt
  createdAt                DateTime               @default(now())

  @@index([tenantId, clinicId, status])
  @@index([tenantId, clinicId, providerKey, deviceId, status, createdAt])
}

model FiscalPosChain {
  tenantId         String
  clinicId         String
  providerKey      String
  deviceId         String
  lastAcceptedUuid String?
  updatedAt        DateTime @updatedAt

  @@id([tenantId, clinicId, providerKey, deviceId])
}

