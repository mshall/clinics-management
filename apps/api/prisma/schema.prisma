generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  PLATFORM_SUPER_ADMIN
  GROUP_ADMIN
  GROUP_SUPERVISOR
  BRANCH_MANAGER
  PHYSICIAN
  NURSE
  RECEPTIONIST
  CALL_CENTER
  HR_OFFICER
  FINANCE_OFFICER
  CLINIC_ADMIN
  CLINIC_ASSISTANT
}

enum Gender {
  M
  F
  OTHER
  UNKNOWN
}

enum PatientAllergyCode {
  PENICILLIN
  AMOXICILLIN
  SULFA
  ASPIRIN
  NSAIDS
  LATEX
  PEANUTS
  TREE_NUTS
  SHELLFISH
  EGGS
  MILK
  SOY
  WHEAT
  BEE_STING
  CONTRAST_IODINE
  CODEINE
  MORPHINE
  OTHER
}

enum Locale {
  en
  ar
}

enum EncounterStatus {
  DRAFT
  FINALIZED
  AMENDED
}

enum ClinicalLetterType {
  SICK_LEAVE
  MEDICAL_REPORT
  REFERRAL
  FITNESS_CERTIFICATE
}

enum ClinicalShortcutType {
  TEXT_EXPAND
  DIAGNOSIS_FAV
  RX_SET
  COPY_LAST_VISIT
}

enum RevenueStatus {
  POSTED
  VOID
}

enum ExpenseStatus {
  PENDING
  APPROVED
  REJECTED
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACTOR
  LOCUM
}

enum ClinicalSpecialty {
  POLYCLINIC
  GENERAL_MEDICINE
  PAIN_MANAGEMENT
  ORTHOPEDICS
  PEDIATRICS
  DERMATOLOGY
  DENTISTRY
  PHYSIO_THERAPY
  AESTHETICS
  CARDIOLOGY
  OBSTETRICS_GYNECOLOGY
  ENT
  OPHTHALMOLOGY
  PSYCHIATRY
  RADIOLOGY
  LABORATORY
  INTERNAL_MEDICINE
  FAMILY_MEDICINE
}

enum EmployeeRecordStatus {
  ACTIVE
  INACTIVE
}

enum ClinicRecordStatus {
  ACTIVE
  INACTIVE
}

enum EmployeeSeparationReason {
  RESIGNATION
}

enum LeaveType {
  ANNUAL
  SICK
  UNPAID
  OTHER
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  CHECKED_IN
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum PatientActiveProblemStatus {
  ACTIVE
  RESOLVED
}

enum PatientFamilyRelation {
  PARENT
  CHILD
  SPOUSE
  GUARDIAN
  OTHER
}

enum ClinicalPhotoKind {
  BEFORE
  AFTER
  GENERAL
}

enum EncounterFollowUpStatus {
  NONE
  PENDING_BOOKING
  REMINDER_SENT
  BOOKED
}

enum AppointmentWaitlistStatus {
  WAITING
  OFFERED
  BOOKED
  CANCELLED
}

enum OperationDocumentKind {
  ATTACHMENT
  PRESCRIPTION
  CONSENT
  OPERATION_NOTE
}

enum OperationStatus {
  SCHEDULED
  BOOKED
  PRE_OP
  IN_PROGRESS
  RECOVERY
  DISCHARGED
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  WALLET
  OTHER
}

enum MessageChannel {
  SMS
  WHATSAPP
  EMAIL
}

enum EtaReceiptStatus {
  PENDING
  SUBMITTED
  ACCEPTED
  REJECTED
}

enum RecallCampaignKind {
  CHECKUP_DUE
  LAPSED
  BIRTHDAY
  CUSTOM
}

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
  ON_LEAVE
}

enum EncounterDocumentKind {
  LAB
  RADIOLOGY
  PRESCRIPTION
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_ON_USER
  RESOLVED
  CLOSED
}

enum SupportTicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum IntegrationScope {
  APPOINTMENTS_READ
  APPOINTMENTS_WRITE
  OPERATIONS_READ
  OPERATIONS_WRITE
}

enum IntegrationWebhookEvent {
  APPOINTMENT_BOOKED
  APPOINTMENT_CANCELLED
  OPERATION_BOOKED
  OPERATION_CANCELLED
}

enum IntegrationFailureCategory {
  AUTH
  APPOINTMENT
  OPERATION
  WEBHOOK
}

enum IntegrationFailureStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

enum SupportProductModule {
  PATIENTS
  ENCOUNTERS
  APPOINTMENTS
  OPERATIONS
  EXPENSES
  REVENUE
  HR
  REPORTS
  ADMIN
  AUTH
  CLINICS
  BILLING
  OTHER
}

enum PatientAcquisitionChannel {
  SOCIAL_FACEBOOK
  SOCIAL_INSTAGRAM
  SOCIAL_TIKTOK
  WEBSITE_GOOGLE
  DOCTOR_REFERRAL
  OTHER
}

model Tenant {
  id                    String          @id @default(cuid())
  name                  String
  nameAr                String          @default("")
  baseCurrency          String          @default("AED")
  defaultLocale         String          @default("en")
  defaultVisitFee Decimal         @default(150) @db.Decimal(14, 2)
  encounterAutoLockHours         Int             @default(72)
  defaultTaxRegistrationNumber String          @default("N/A")
  defaultInvoiceVatPercent     Decimal         @default(5) @db.Decimal(5, 2)
  integrationFailureRetentionDays     Int       @default(30)
  integrationFailureLastSpikeAlertAt  DateTime?
  users          User[]
  clinics        Clinic[]
  clinicAdminScopes ClinicAdminScope[]
  patients       Patient[]
  encounters     Encounter[]
  revenueEntries RevenueEntry[]
  expenses       Expense[]
  employees      Employee[]
  appointments   Appointment[]
  operations     Operation[]
  auditLogs              AuditLog[]
  diagnoses              Diagnosis[]
  encounterMedications   EncounterMedication[]
  encounterDocuments     EncounterDocument[]
  operationDocuments     OperationDocument[]
  operationMedications   OperationMedication[]
  patientDocuments       PatientDocument[]
  patientAllergies       PatientAllergy[]
  invoices               Invoice[]
  userNavTabGrants       UserNavTabGrant[]
  tenantRoleNavTabGrants TenantRoleNavTabGrant[]
  userClinicEmployeePrivilegeGrants UserClinicEmployeePrivilegeGrant[]
  supportTickets                 SupportTicket[]
  integrationClients             IntegrationClient[]
  integrationWebhooks            IntegrationWebhook[]
  integrationFailureLogs         IntegrationFailureLog[]
  clinicalFormTemplates          ClinicalFormTemplate[]
  icd10Entries                   Icd10Entry[]
  clinicianShortcuts             ClinicianShortcut[]
  clinicianDiagnosisFavorites    ClinicianDiagnosisFavorite[]
  drugInteractionRules           DrugInteractionRule[]
  clinicalLetters                ClinicalLetter[]
  appointmentTypes               AppointmentType[]
  clinicianAvailabilityTemplates ClinicianAvailabilityTemplate[]
  appointmentSeries              AppointmentSeries[]
  appointmentWaitlist            AppointmentWaitlistEntry[]
  patientActiveProblems          PatientActiveProblem[]
  patientFamilyLinks             PatientFamilyLink[]
  patientClinicalPhotos          PatientClinicalPhoto[]
  serviceCatalogItems            ServiceCatalogItem[]
  payerCompanies                 PayerCompany[]
  messageTemplates               MessageTemplate[]
  recallCampaigns                RecallCampaign[]
  commissionRules                CommissionRule[]
  cashierShiftCloses             CashierShiftClose[]
  patientServicePackages         PatientServicePackage[]
  billingPayments                BillingPayment[]
  etaReceipts                    EtaReceiptSubmission[]
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
}

model User {
  id           String         @id @default(cuid())
  tenantId     String?
  tenant       Tenant?        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email        String
  passwordHash String
  displayName  String
  role         UserRole
  avatarRelativePath String?
  avatarMimeType     String?
  employee     Employee?
  encounters   Encounter[]    @relation("EncounterClinician")
  appointments Appointment[] @relation("AppointmentClinician")
  operationsPerformed Operation[] @relation("OperationClinician")
  operationsCreated   Operation[] @relation("OperationCreatedBy")
  invoicesCreated     Invoice[]   @relation("InvoiceCreatedBy")
  auditLogsAsActor AuditLog[] @relation("AuditLogActor")
  clinicAdminScopes ClinicAdminScope[]
  navTabGrant       UserNavTabGrant? @relation("UserNavTabGrantUser")
  navTabGrantsUpdated UserNavTabGrant[] @relation("UserNavTabGrantUpdatedBy")
  tenantRoleNavTabGrantsUpdated TenantRoleNavTabGrant[] @relation("TenantRoleNavTabGrantUpdatedBy")
  employeePrivilegeGrants UserClinicEmployeePrivilegeGrant[] @relation("EmployeePrivilegeGrantUser")
  employeePrivilegeGrantsUpdated UserClinicEmployeePrivilegeGrant[] @relation("EmployeePrivilegeGrantUpdatedBy")
  supportTicketsReported         SupportTicket[] @relation("SupportTicketReporter")
  supportTicketsAssigned         SupportTicket[] @relation("SupportTicketAssignee")
  supportTicketEvents            SupportTicketEvent[] @relation("SupportTicketEventActor")
  integrationClientsCreated      IntegrationClient[] @relation("IntegrationClientCreatedBy")
  integrationFailuresResolved    IntegrationFailureLog[] @relation("IntegrationFailureResolvedBy")
  clinicianAvailabilityTemplates ClinicianAvailabilityTemplate[] @relation("ClinicianAvailability")
  appointmentSeriesAsClinician   AppointmentSeries[] @relation("AppointmentSeriesClinician")
  waitlistAsClinician            AppointmentWaitlistEntry[] @relation("WaitlistClinician")
  clinicalFormTemplatesOwned     ClinicalFormTemplate[] @relation("ClinicalFormTemplateOwner")
  clinicianShortcuts               ClinicianShortcut[]
  clinicianDiagnosisFavorites    ClinicianDiagnosisFavorite[]
  encountersSigned               Encounter[] @relation("EncounterSignedBy")
  encountersAmended              Encounter[] @relation("EncounterAmendedBy")
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  deactivatedAt DateTime?
  deletedAt     DateTime?

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([tenantId, deletedAt])
}

model UserNavTabGrant {
  id                String   @id @default(cuid())
  tenantId          String
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId            String   @unique
  user              User     @relation("UserNavTabGrantUser", fields: [userId], references: [id], onDelete: Cascade)
  tabKeys           Json
  updatedByUserId   String?
  updatedBy         User?    @relation("UserNavTabGrantUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([tenantId, userId])
  @@index([tenantId])
}

model TenantRoleNavTabGrant {
  id              String   @id @default(cuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role            UserRole
  tabKeys         Json
  updatedByUserId String?
  updatedBy       User?    @relation("TenantRoleNavTabGrantUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([tenantId, role])
  @@index([tenantId])
}

model UserClinicEmployeePrivilegeGrant {
  id              String   @id @default(cuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId          String
  user            User     @relation("EmployeePrivilegeGrantUser", fields: [userId], references: [id], onDelete: Cascade)
  clinicId        String
  clinic          Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  updatedByUserId String?
  updatedBy       User?    @relation("EmployeePrivilegeGrantUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([userId, clinicId])
  @@index([tenantId, userId])
  @@index([tenantId, clinicId])
}

model Clinic {
  id               String          @id @default(cuid())
  tenantId         String
  tenant           Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parentClinicId   String?
  parent           Clinic?         @relation("ClinicHierarchy", fields: [parentClinicId], references: [id])
  branches         Clinic[]        @relation("ClinicHierarchy")
  nameEn           String
  nameAr           String
  logoUrl          String?
  country          String
  city             String
  addressEn        String
  addressAr        String
  locationUrl      String
  phone            String
  email            String
  licenseNumber    String
  clinicalSpecialty ClinicalSpecialty @default(POLYCLINIC)
  taxRegistrationNumber String?
  invoiceVatPercent   Decimal       @default(5) @db.Decimal(5, 2)
  defaultLanguage  Locale          @default(en)
  defaultCurrency  String          @default("AED")
  invoiceLogoRelativePath String?
  invoiceLogoOriginalName String?
  invoiceLogoMimeType     String?
  invoiceBackgroundColor  String      @default("white")
  invoiceSections         Json        @default("[\"clinicHeader\",\"patientDetails\",\"invoiceMeta\",\"lineItems\",\"totals\",\"footer\"]")
  prescriptionLogoRelativePath String?
  prescriptionLogoOriginalName String?
  prescriptionLogoMimeType     String?
  prescriptionHeaderDescriptionEn String @default("")
  prescriptionHeaderDescriptionAr String @default("")
  openingTime        String          @default("09:00") @db.VarChar(5)
  closingTime        String          @default("00:00") @db.VarChar(5)
  frontDeskRoomLabels Json           @default("[\"Room 1\",\"Room 2\",\"Room 3\"]")
  lastCalledTicketNumber Int?
  patientsHome     Patient[]       @relation("PatientHomeBranch")
  encounters       Encounter[]
  revenueEntries   RevenueEntry[]
  expenses         Expense[]
  employees        Employee[]
  appointments     Appointment[]
  operations       Operation[]
  invoices         Invoice[]
  billingPayments  BillingPayment[]
  cashierShiftCloses CashierShiftClose[]
  etaReceipts      EtaReceiptSubmission[]
  auditLogs        AuditLog[]
  clinicAdminScopes ClinicAdminScope[]
  employeePrivilegeGrants UserClinicEmployeePrivilegeGrant[]
  recordStatus      ClinicRecordStatus      @default(ACTIVE)
  disabledAt        DateTime?
  operatingPeriods  ClinicOperatingPeriod[]
  supportTickets    SupportTicket[]
  integrationFailureLogs IntegrationFailureLog[]
  appointmentTypes       AppointmentType[]
  clinicianAvailabilityTemplates ClinicianAvailabilityTemplate[]
  appointmentSeries      AppointmentSeries[]
  appointmentWaitlist    AppointmentWaitlistEntry[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([tenantId])
  @@index([parentClinicId])
  @@index([tenantId, recordStatus])
}

model ClinicOperatingPeriod {
  id        String   @id @default(cuid())
  clinicId  String
  clinic    Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  startDate DateTime @db.Date
  endDate   DateTime? @db.Date
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clinicId])
  @@index([clinicId, startDate])
}

model ClinicAdminScope {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  clinicId  String
  clinic    Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, clinicId])
  @@index([tenantId, userId])
}

model Patient {
  id           String         @id @default(cuid())
  tenantId     String
  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  mrn          String
  firstNameEn  String
  lastNameEn   String
  firstNameAr  String?
  lastNameAr   String?
  dob          DateTime?
  gender       Gender
  phone        String
  email        String?
  nationalId   String?
  nationalIdDocRelativePath String?
  nationalIdDocOriginalName String?
  nationalIdDocMimeType     String?
  acquisitionChannel          PatientAcquisitionChannel?
  acquisitionReferralName     String?
  acquisitionOtherDetail      String?
  homeBranchId String?
  homeBranch   Clinic?        @relation("PatientHomeBranch", fields: [homeBranchId], references: [id])
  deletedAt    DateTime?
  encounters   Encounter[]
  appointments Appointment[]
  operations   Operation[]
  documents    PatientDocument[]
  invoices     Invoice[]
  supportTickets SupportTicket[]
  allergies    PatientAllergy[]
  clinicalLetters ClinicalLetter[]
  activeProblems PatientActiveProblem[]
  familyLinksFrom PatientFamilyLink[] @relation("PatientFamilyFrom")
  familyLinksTo   PatientFamilyLink[] @relation("PatientFamilyTo")
  clinicalPhotos  PatientClinicalPhoto[]
  waitlistEntries AppointmentWaitlistEntry[]
  appointmentSeries AppointmentSeries[]
  noShowCount          Int      @default(0)
  requiresAppointmentDeposit Boolean @default(false)
  isVip                Boolean  @default(false)
  needsChaperone       Boolean  @default(false)
  dataProtectionConsents PatientDataProtectionConsent[]
  servicePackages      PatientServicePackage[]
  billingPayments      BillingPayment[]
  etaReceipts          EtaReceiptSubmission[]
  satisfactionSurveys  SatisfactionSurveyResponse[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@unique([tenantId, mrn])
  @@unique([tenantId, nationalId])
  @@index([tenantId])
  @@index([tenantId, phone])
}

model ClinicalFormTemplate {
  id           String            @id @default(cuid())
  tenantId     String
  tenant       Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ownerUserId  String?
  owner        User?             @relation("ClinicalFormTemplateOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  specialty    ClinicalSpecialty
  name         String
  description  String            @default("")
  sectionsJson Json
  isPublished  Boolean           @default(false)
  encounters   Encounter[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([tenantId, specialty])
  @@index([tenantId, ownerUserId])
}

model ClinicianShortcut {
  id        String               @id @default(cuid())
  tenantId  String
  tenant    Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      ClinicalShortcutType
  label     String
  trigger   String?
  payload   Json
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@index([tenantId, userId, type])
}

model ClinicianDiagnosisFavorite {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  icd10Code   String
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  @@unique([tenantId, userId, icd10Code])
  @@index([tenantId, userId])
}

model Icd10Entry {
  id            String   @id @default(cuid())
  tenantId      String?
  tenant        Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  icd10Code     String
  descriptionEn String
  descriptionAr String   @default("")
  keywords      String   @default("")
  createdAt     DateTime @default(now())

  @@index([tenantId])
  @@index([icd10Code])
}

model DrugInteractionRule {
  id          String   @id @default(cuid())
  tenantId    String?
  tenant      Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  drugA       String
  drugB       String
  severity    String   @default("moderate")
  messageEn   String
  messageAr   String   @default("")
  createdAt   DateTime @default(now())

  @@index([tenantId])
}

model ClinicalLetter {
  id             String             @id @default(cuid())
  tenantId       String
  tenant         Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  encounterId    String?
  encounter      Encounter?         @relation(fields: [encounterId], references: [id], onDelete: SetNull)
  patientId      String
  patient        Patient            @relation(fields: [patientId], references: [id], onDelete: Cascade)
  type           ClinicalLetterType
  titleEn        String
  titleAr        String             @default("")
  bodyEn         String
  bodyAr         String             @default("")
  createdByUserId String
  createdAt      DateTime           @default(now())

  @@index([tenantId, patientId])
  @@index([encounterId])
}

model PatientAllergy {
  id           String             @id @default(cuid())
  tenantId     String
  tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patientId    String
  patient      Patient            @relation(fields: [patientId], references: [id], onDelete: Cascade)
  code         PatientAllergyCode
  otherComment String?
  encounterId  String?
  encounter    Encounter?         @relation(fields: [encounterId], references: [id], onDelete: SetNull)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([tenantId])
  @@index([patientId])
}

model PatientDocument {
  id               String   @id @default(cuid())
  tenantId         String
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patientId        String
  patient          Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  description      String
  originalFileName String
  mimeType         String
  sizeBytes        Int
  relativePath     String
  createdAt        DateTime @default(now())

  @@index([tenantId])
  @@index([patientId])
}

model Encounter {
  id             String            @id @default(cuid())
  tenantId       String
  tenant         Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clinicId       String
  clinic         Clinic            @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patientId      String
  patient        Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  clinicianId    String
  clinician      User              @relation("EncounterClinician", fields: [clinicianId], references: [id], onDelete: Restrict)
  status         EncounterStatus   @default(DRAFT)
  visitType      String
  chiefComplaint String?
  subjective     String?
  objective      String?
  assessment     String?
  plan           String?
  vitalsJson     Json?
  heartRate      Int?
  spo2           Int?
  bpSystolic     Int?
  bpDiastolic    Int?
  temperature    Decimal?          @db.Decimal(4, 1)
  weightKg       Decimal?          @db.Decimal(6, 2)
  heightCm       Decimal?          @db.Decimal(6, 2)
  noMedications  Boolean           @default(false)
  visitFeeAmount Decimal           @default(0) @db.Decimal(14, 2)
  visitFeeCurrency String          @default("AED")
  appointmentId  String?
  appointment    Appointment?     @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  finalizedAt    DateTime?
  clinicalTemplateId String?
  clinicalTemplate   ClinicalFormTemplate? @relation(fields: [clinicalTemplateId], references: [id], onDelete: SetNull)
  specialtyFormResponses Json?
  noteLockedAt   DateTime?
  signedAt       DateTime?
  signedByUserId String?
  signedBy       User?             @relation("EncounterSignedBy", fields: [signedByUserId], references: [id], onDelete: SetNull)
  amendReason    String?
  amendedByUserId String?
  amendedBy      User?             @relation("EncounterAmendedBy", fields: [amendedByUserId], references: [id], onDelete: SetNull)
  amendedAt      DateTime?
  clinicalLetters ClinicalLetter[]
  diagnoses      Diagnosis[]
  revenueEntries RevenueEntry[]
  medications    EncounterMedication[]
  documents      EncounterDocument[]
  patientAllergies PatientAllergy[]
  activeProblemsEncounter PatientActiveProblem[]
  invoices       Invoice[]
  followUpDueAt  DateTime?
  followUpWeeks  Int?
  followUpNote   String?
  followUpStatus EncounterFollowUpStatus @default(NONE)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([tenantId, clinicId, finalizedAt])
  @@index([patientId])
  @@index([appointmentId])
  @@index([tenantId, followUpStatus, followUpDueAt])
}

model Diagnosis {
  id             String    @id @default(cuid())
  tenantId       String
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  encounterId    String
  encounter      Encounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  icd10Code      String
  descriptionEn  String
  descriptionAr  String?
  isPrimary      Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([tenantId])
  @@index([encounterId])
}

model EncounterMedication {
  id           String    @id @default(cuid())
  tenantId     String
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  encounterId  String
  encounter    Encounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  drugName     String
  dosage       String?
  route        String?
  frequency    String?
  duration     String?
  instructions String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([tenantId])
  @@index([encounterId])
}

model EncounterDocument {
