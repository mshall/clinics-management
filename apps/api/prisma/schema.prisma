  ISSUED
  PAID
  PARTIALLY_PAID
  VOID
  UNCOLLECTIBLE
}

enum KiorlyLineType {
  SUBSCRIPTION
  SEAT
  ADDON
  USAGE_OVERAGE
  KIOREX_COMMISSION
  KIOREX_COMMISSION_OFFSET
  PREPAID
  CREDIT
  DISCOUNT
