  clinic              Clinic?                            @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  nameEn              String
  nameAr              String                             @default("")
  durationMinutes     Int                                @default(15)
  feeAmount           Decimal                            @default(0) @db.Decimal(14, 2)
  colorHex            String                             @default("#3b82f6")
  bufferBeforeMin     Int                                @default(0)
  bufferAfterMin      Int                                @default(0)
