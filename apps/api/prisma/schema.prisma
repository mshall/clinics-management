enum ImportEntity {
  PATIENTS
  APPOINTMENTS
  PRICE_LIST
  STAFF
}

enum ImportJobStatus {
  VALIDATING
  READY
  COMMITTING
  DONE
  FAILED
  UNDONE
}

/// ON-05 — spreadsheet import (validate → preview → background commit → 24h undo).
model ImportJob {
  id              String          @id @default(cuid())
  tenantId        String
  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  entity          ImportEntity
  fileKey         String
  fileName        String          @default("")
  status          ImportJobStatus @default(VALIDATING)
  /// SKIP keeps existing patients untouched; MERGE fills their empty fields from the file.
  dedupeMode      String          @default("SKIP")
  totalRows       Int             @default(0)
  okRows          Int             @default(0)
  errorRows       Int             @default(0)
  duplicateRows   Int             @default(0)
  createdRows     Int             @default(0)
  mergedRows      Int             @default(0)
  /// Normalized valid rows awaiting commit (cleared after commit).
  rowsJson        Json?
  /// Row-level validation errors `{ row, field, code }[]`.
  errorsJson      Json?
  /// Ids created by commit, per model — drives undo.
  createdIdsJson  Json?
  reportKey       String?
  failureMessage  String?
  createdBy       String
  /// ON-07 — field rep importing on behalf of the clinic.
  actingRepUserId String?
  committedAt     DateTime?
  undoUntil       DateTime?
  undoneAt        DateTime?
  createdAt       DateTime        @default(now())
  finishedAt      DateTime?

  @@index([tenantId, createdAt])
}

/// ON-07 — field-sales rep account (login is a tenant-less User with role SALES_REP).
model SalesRep {
  id          String   @id @default(cuid())
  userId      String   @unique
  /// Attribution code stored on Tenant/Subscription.salesRepCode.
  code        String   @unique
  displayName String
  phone       String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// ON-06 — staff invitation (WhatsApp or email link → set password).
model Invitation {
  id             String     @id @default(cuid())
  tenantId       String
  tenant         Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  phoneOrEmail   String
  /// WHATSAPP | EMAIL
  channel        String
  displayName    String     @default("")
  roles          UserRole[]
  clinicIds      String[]   @default([])
  tokenHash      String     @unique
  expiresAt      DateTime
  acceptedAt     DateTime?
  acceptedUserId String?
  revokedAt      DateTime?
  sendCount      Int        @default(1)
  lastSentAt     DateTime   @default(now())
  createdBy      String
  createdAt      DateTime   @default(now())

  @@index([tenantId, createdAt])
}

