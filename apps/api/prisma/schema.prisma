model FiscalDevice {
  id                String              @id @default(cuid())
  tenantId          String
  tenant            Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clinicId          String
  clinic            Clinic              @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  providerKey       String
  kind              FiscalDeviceKind
  serialNumber      String
  label             String?
  deviceModel       String?
  osVersion         String?
  status            FiscalDeviceStatus  @default(CREDENTIALS_PENDING)
  isDefault         Boolean             @default(false)
  credentialId      String?             @unique
  credential        ProviderCredential? @relation(fields: [credentialId], references: [id], onDelete: SetNull)
  lastReceiptUuid   String?
  receiptSequence   Int                 @default(0)
  lastSubmittedAt   DateTime?
  registeredAt      DateTime?
  activatedAt       DateTime?
  deactivatedAt     DateTime?
  statusReason      String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  fiscalDocuments   FiscalDocument[]
  fiscalSubmissions FiscalSubmission[]

  @@unique([tenantId, providerKey, serialNumber])
  @@index([tenantId, clinicId, providerKey])
  @@index([tenantId, clinicId, providerKey, isDefault])
