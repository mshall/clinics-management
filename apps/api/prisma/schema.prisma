  moneyVisibilityOverride         UserMoneyVisibilityOverride?       @relation("UserMoneyVisibilityOverrideUser")
  moneyVisibilityOverridesUpdated UserMoneyVisibilityOverride[]      @relation("UserMoneyVisibilityOverrideUpdatedBy")
  supportTicketsReported          SupportTicket[]                    @relation("SupportTicketReporter")
  supportTicketsAssigned          SupportTicket[]                    @relation("SupportTicketAssignee")
  supportTicketEvents             SupportTicketEvent[]               @relation("SupportTicketEventActor")
  supportAccessRequested          SupportAccessSession[]             @relation("SupportAccessRequester")
  supportAccessApproved           SupportAccessSession[]             @relation("SupportAccessApprover")
  integrationClientsCreated       IntegrationClient[]                @relation("IntegrationClientCreatedBy")
  integrationFailuresResolved     IntegrationFailureLog[]            @relation("IntegrationFailureResolvedBy")
  clinicianAvailabilityTemplates  ClinicianAvailabilityTemplate[]    @relation("ClinicianAvailability")
  appointmentTypeOverrides        ClinicianAppointmentTypeOverride[] @relation("ClinicianApptTypeOverride")
  telehealthSetting               ClinicianTelehealthSetting?        @relation("ClinicianTelehealth")
  appointmentSeriesAsClinician    AppointmentSeries[]                @relation("AppointmentSeriesClinician")
  waitlistAsClinician             AppointmentWaitlistEntry[]         @relation("WaitlistClinician")
  clinicalFormTemplatesOwned      ClinicalFormTemplate[]             @relation("ClinicalFormTemplateOwner")
  clinicianShortcuts              ClinicianShortcut[]
  clinicianDiagnosisFavorites     ClinicianDiagnosisFavorite[]
  encountersSigned                Encounter[]                        @relation("EncounterSignedBy")
  encountersAmended               Encounter[]                        @relation("EncounterAmendedBy")
  passwordResetTokens             PasswordResetToken[]
  authSessions                    UserSession[]
  legalAcceptances                LegalAcceptance[]
  digestPreference                StaffDigestPreference?
  inAppNotices                    StaffInAppNotice[]
  digestSendLogs                  DigestSendLog[]
  clinicianVerification           ClinicianVerification?
  clinicianVerificationsReviewed  ClinicianVerification[]            @relation("ClinicianVerificationReviewer")
  marketplaceListings             MarketplaceListing[]
  slotHoldsAsClinician            SlotHold[]                         @relation("SlotHoldClinician")
  pushSubscriptions               PushSubscription[]
  createdAt                       DateTime                           @default(now())
  updatedAt                       DateTime                           @updatedAt
  deactivatedAt                   DateTime?
  deletedAt                       DateTime?
  kiorexIdentityLink              KiorexIdentityLink?

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([tenantId, deletedAt])
