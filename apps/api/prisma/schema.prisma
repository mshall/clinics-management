/// Counts only: which template was shared through which channel. Never the rendered content, a patient or a slot time.
model SocialShareLog {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clinicId   String
  clinic     Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  templateId String
  channel    String
  createdBy  String
  createdAt  DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([templateId])
}

model ProviderRecommendationState {
  tenantId  String
  tenant    Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clinicId  String
  clinic    Clinic                       @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  key       String
  status    ProviderRecommendationStatus @default(OPEN)
  until     DateTime?
  updatedBy String
  updatedAt DateTime                     @updatedAt

  @@id([clinicId, key])
  @@index([tenantId])
}

/// A provider asks Kiorex ops to change a verified public profile field. `newValueEnc` is encrypted at rest (AES-256-GCM, the clinician PII key) and travels to Kiorex only in the signed marketplace call body, never in an event.
model ProviderVerificationUpdateRequest {
  id               String                   @id @default(cuid())
  tenantId         String
  tenant           Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clinicId         String
  clinic           Clinic                   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  field            VerificationUpdateField
  oldRef           String?
  newValueEnc      String
  evidenceFileRefs Json                     @default("[]")
  status           VerificationUpdateStatus @default(SUBMITTED)
  kiorexRef        String?
  decidedAt        DateTime?
  decisionNote     String?
  createdBy        String
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  @@index([tenantId, status])
  @@index([clinicId, createdAt])
}

model CommissionStatementExport {
  id          String              @id @default(cuid())
  tenantId    String
  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  month       String
  kind        StatementExportKind
  fileRef     String?
  checksum    String
  generatedBy String
  createdAt   DateTime            @default(now())

  @@index([tenantId, month])
}

// ───────────────────────── GRW-P2-S provider-sponsored promotions (migration 20270107120000_growth_sponsored_promotions) ─────────────────────────
// A discount the CLINIC funds from its own provider credit. The patient never receives provider credit; no row here references a patient credit object (RC-S5).
// Money is in minor units (piastres). The budget is an append-only ledger (PromotionBudgetEntry) guarded by a deferred constraint trigger.

enum PromotionStatus {
  DRAFT
  SUBMITTED
  IN_REVIEW
  APPROVED
  ACTIVE
  PAUSED
  EXHAUSTED
  EXPIRED
  REJECTED
  ARCHIVED
}

enum PromotionDiscountKind {
  FIXED_MINOR
  PERCENT_BP
}

enum PromotionFundingMode {
  WALLET_ONLY
  WALLET_THEN_INVOICE
}

enum PromotionReviewKind {
  CONTENT
  SCOPE
  HIGH_VALUE
}

enum PromotionReviewDecision {
  APPROVED
  REJECTED
  NEEDS_CHANGES
}

enum PromotionBudgetEntryType {
  RESERVE
  RELEASE
  DEBIT
  REVERSE_DEBIT
}

enum PromotionReservationState {
  RESERVED
  BOOKED
  DEBITED
  RELEASED
  REVERSED
}

model SponsoredPromotion {
  id               String          @id @default(cuid())
  tenantId         String
  tenant           Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  status           PromotionStatus @default(DRAFT)
  currentVersionId String?
  createdBy        String
  pausedAt         DateTime?
  pauseReason      String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  versions      SponsoredPromotionVersion[]
  budgetEntries PromotionBudgetEntry[]
  reservations  PromotionReservation[]
  audits        PromotionAudit[]

  @@index([tenantId, status])
  @@index([status])
}

/// Immutable (trigger): an edit creates a new version; bookings cite the version they used.
model SponsoredPromotionVersion {
  id                  String                @id @default(cuid())
  promotionId         String
  promotion           SponsoredPromotion    @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  version             Int
  nameAr              String
  nameEn              String
  patientCopyAr       String
  patientCopyEn       String
  scope               Json
  discountKind        PromotionDiscountKind
  discountValue       Int
  maxPerBookingMinor  Int?
  budgetCapMinor      Int
  perPatientLimit     Int                   @default(1)
  perDayLimit         Int?
  eligibility         Json
  startsAt            DateTime
  endsAt              DateTime
  fundingMode         PromotionFundingMode  @default(WALLET_ONLY)
  policyVersion       String
  referencePriceMinor Int
  contentHash         String
  guardResult         Json                  @default("{}")
  createdBy           String
  createdAt           DateTime              @default(now())

  reviews PromotionComplianceReview[]

  @@unique([promotionId, version])
}

model PromotionComplianceReview {
  id          String                    @id @default(cuid())
  promotionId String
  versionId   String
  version     SponsoredPromotionVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  kind        PromotionReviewKind
  requestedBy String
  decidedBy   String?
  decision    PromotionReviewDecision?
  reason      String?
  guardResult Json                      @default("{}")
  createdAt   DateTime                  @default(now())
  decidedAt   DateTime?

  @@unique([versionId, kind])
  @@index([promotionId])
}

/// Append-only (trigger). reserved + debited - released - reversed <= budget cap at commit (deferred constraint trigger).
model PromotionBudgetEntry {
  id             String                   @id @default(cuid())
  promotionId    String
  promotion      SponsoredPromotion       @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  versionId      String
  type           PromotionBudgetEntryType
  amountMinor    Int
  currency       String                   @default("EGP")
  idempotencyKey String                   @unique
  appointmentId  String?
  bookingRef     String?
  reservationId  String?
  walletEntryId  String?
  invoiceLineId  String?
  reason         String
  createdAt      DateTime                 @default(now())

  @@index([promotionId, type])
  @@index([reservationId])
}

model PromotionAudit {
  id          String             @id @default(cuid())
  promotionId String
  promotion   SponsoredPromotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  actor       String
  action      String
  snapshot    Json               @default("{}")
  at          DateTime           @default(now())

  @@index([promotionId, at])
}

/// One budget hold of one booking (the mutable state of the append-only budget entries). patientRef is an opaque keyed hash; it never is a Passport sub.
model PromotionReservation {
  id             String                    @id @default(cuid())
  tenantId       String
  promotionId    String
  promotion      SponsoredPromotion        @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  versionId      String
  reservationRef String                    @unique
  bookingRef     String
  patientRef     String
  careType       String
  amountMinor    Int
  currency       String                    @default("EGP")
  state          PromotionReservationState @default(RESERVED)
  appointmentId  String?
  expiresAt      DateTime
  idempotencyKey String                    @unique
  debitedMinor   Int?
  shortfallMinor Int?
  invoicedAt     DateTime?
  /// the Kiorly invoice period (YYYY-MM) whose PROMOTION_EXPENSE line carries the shortfall; a re-run of the same draft period keeps it
  invoicedPeriod String?
  createdAt      DateTime                  @default(now())
  settledAt      DateTime?

  @@unique([promotionId, bookingRef])
  @@index([tenantId, state])
  @@index([appointmentId])
  @@index([state, expiresAt])
  @@index([promotionId, patientRef])
}

/// GRW-P4-C: a provider refers a COMPANY to Kiorex as an enterprise lead (Kiorex ops follow up). Company data only: `contactRef` is the provider's own opaque reference to the contact (never a name, phone or e-mail).
/// No reward, credit, fee share or wallet entry exists for this referral (any fee share is counsel and CEO gated). Delivered once through the outbox as `CorporateLeadReferred`.
model ProviderB2BReferral {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clinicId    String
  clinic      Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  companyName String
  /// Normalised company name (lower case, letters and digits): duplicates inside one organisation are refused for 90 days.
  companyKey  String
  /// 1_49 50_199 200_999 1000_PLUS UNKNOWN
  sizeBucket  String   @default("UNKNOWN")
  contactRef  String?
  /// SUBMITTED (Kiorex has the lead; Kiorex's own pipeline is internal and is not mirrored back in this phase)
  status      String   @default("SUBMITTED")
  createdBy   String
  createdAt   DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([tenantId, companyKey])
}
